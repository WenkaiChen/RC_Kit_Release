SUBROUTINE CUDA_ZBATCH_GEMM_CONST_LEFT(HBLAS, N, CHUNK, STRIDE, D_J, D_WORK, &
  OFF_B, OFF_C, D_PTR_A, D_PTR_B, D_PTR_C, IERR)
