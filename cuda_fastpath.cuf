MODULE CUDA_FASTPATH
USE cudafor
USE cublas
USE cusolverDn
IMPLICIT NONE
INTEGER, PARAMETER :: DP = KIND(1.0D0)
INTEGER, PARAMETER :: BLOCK_SIZE = 256
REAL(DP), PARAMETER :: AUT2S_CUDA = 2.418884254D-17
REAL(DP), PARAMETER :: AUT2FS_CUDA = 2.418884326505D-2
REAL(DP), PARAMETER :: PI_CUDA = 3.1415926535897932384626433832795D0
COMPLEX(DP), PARAMETER :: IMG_CUDA = CMPLX(0.0D0, 1.0D0, KIND=DP)
LOGICAL, SAVE :: CUDA_DEVICE_CHECKED = .FALSE.
LOGICAL, SAVE :: CUDA_DEVICE_AVAILABLE = .FALSE.
INTEGER, SAVE :: CUDA_DEVICE_STATUS = -1
INTEGER, SAVE :: CUDA_DEVICE_COUNT = 0
CONTAINS

LOGICAL FUNCTION CUDA_FASTPATH_AVAILABLE() RESULT(OK)
INTEGER :: STATUS, ENV_LEN, DEVICE_COUNT_LOCAL
CHARACTER(LEN=32) :: DISABLE_ENV

IF (.NOT. CUDA_DEVICE_CHECKED) THEN
  CUDA_DEVICE_CHECKED = .TRUE.
  CUDA_DEVICE_AVAILABLE = .FALSE.
  CUDA_DEVICE_STATUS = -1
  CUDA_DEVICE_COUNT = 0

  DISABLE_ENV = ' '
  ENV_LEN = 0
  CALL GET_ENVIRONMENT_VARIABLE('RC_KIT_DISABLE_CUDA', DISABLE_ENV, LENGTH=ENV_LEN, STATUS=STATUS)
  IF (STATUS == 0 .AND. ENV_LEN > 0) THEN
    IF (DISABLE_ENV(1:1) == '1' .OR. DISABLE_ENV(1:1) == 'T' .OR. DISABLE_ENV(1:1) == 't' .OR. &
      DISABLE_ENV(1:1) == 'Y' .OR. DISABLE_ENV(1:1) == 'y') THEN
      CUDA_DEVICE_STATUS = -7098
      OK = .FALSE.
      RETURN
    END IF
  END IF

  DEVICE_COUNT_LOCAL = 0
  CUDA_DEVICE_STATUS = cudaGetDeviceCount(DEVICE_COUNT_LOCAL)
  CUDA_DEVICE_COUNT = DEVICE_COUNT_LOCAL
  IF (CUDA_DEVICE_STATUS == 0 .AND. CUDA_DEVICE_COUNT > 0) THEN
    CUDA_DEVICE_AVAILABLE = .TRUE.
  END IF
END IF

OK = CUDA_DEVICE_AVAILABLE
END FUNCTION CUDA_FASTPATH_AVAILABLE

SUBROUTINE CUDA_DIAGSYMAT(N_MODE, MAT, EIGVECMAT, EIGVALARR, IERR)
INTEGER, INTENT(IN) :: N_MODE
REAL(DP), INTENT(INOUT) :: MAT(N_MODE,N_MODE)
REAL(DP), INTENT(OUT) :: EIGVECMAT(N_MODE,N_MODE)
REAL(DP), INTENT(OUT) :: EIGVALARR(N_MODE)
INTEGER, INTENT(OUT) :: IERR
TYPE(cusolverDnHandle) :: HANDLE
REAL(DP), DEVICE, ALLOCATABLE :: MAT_D(:,:), EIGVAL_D(:), WORK_D(:)
INTEGER, DEVICE :: INFO_D
INTEGER :: ISTAT, LWORK, INFO_H, I
LOGICAL :: HANDLE_CREATED

IERR = -1
HANDLE_CREATED = .FALSE.
IF (.NOT. CUDA_FASTPATH_AVAILABLE()) RETURN

ALLOCATE(MAT_D(N_MODE,N_MODE), EIGVAL_D(N_MODE))
MAT_D = MAT

ISTAT = cusolverDnCreate(HANDLE)
IF (ISTAT /= 0) GOTO 900
HANDLE_CREATED = .TRUE.

ISTAT = cusolverDnDsyevd_bufferSize(HANDLE, CUSOLVER_EIG_MODE_VECTOR, &
  & CUBLAS_FILL_MODE_UPPER, N_MODE, MAT_D, N_MODE, EIGVAL_D, LWORK)
IF (ISTAT /= 0) GOTO 900

ALLOCATE(WORK_D(LWORK))
ISTAT = cusolverDnDsyevd(HANDLE, CUSOLVER_EIG_MODE_VECTOR, &
  & CUBLAS_FILL_MODE_UPPER, N_MODE, MAT_D, N_MODE, EIGVAL_D, &
  & WORK_D, LWORK, INFO_D)
IF (ISTAT /= 0) GOTO 900

ISTAT = cudaDeviceSynchronize()
IF (ISTAT /= 0) GOTO 900
INFO_H = INFO_D
IF (INFO_H /= 0) THEN
  IERR = INFO_H
  GOTO 900
END IF

EIGVALARR = EIGVAL_D
EIGVECMAT = MAT_D
MAT = 0.0D0
DO I = 1, N_MODE
  MAT(I,I) = EIGVALARR(I)
END DO
IERR = 0

900 CONTINUE
IF (ALLOCATED(WORK_D)) DEALLOCATE(WORK_D)
IF (ALLOCATED(EIGVAL_D)) DEALLOCATE(EIGVAL_D)
IF (ALLOCATED(MAT_D)) DEALLOCATE(MAT_D)
IF (HANDLE_CREATED) ISTAT = cusolverDnDestroy(HANDLE)
END SUBROUTINE CUDA_DIAGSYMAT

PURE SUBROUTINE SIMPSON_FROM_VECTOR(G, A, B, NIN, INTEGRAL)
REAL(DP), INTENT(IN) :: G(:), A, B
INTEGER, INTENT(IN) :: NIN
REAL(DP), INTENT(OUT) :: INTEGRAL
INTEGER :: N, I
REAL(DP) :: H, S
N = NIN
H = (B - A) / DBLE(N)
IF (N == 1) THEN
  INTEGRAL = 0.5D0*H*(G(1)+G(2))
ELSE IF ((N/2)*2 == N) THEN
  S = 0.0D0
  DO I = 2, N-2, 2
    S = S + 2.0D0*G(I+1) + 4.0D0*G(I+2)
  END DO
  INTEGRAL = (S + G(1) + G(N+1) + 4.0D0*G(2))*H/3.0D0
ELSE
  INTEGRAL = 0.0D0
  IF (N > 3) THEN
    S = 0.0D0
    DO I = 2, N-4, 2
      S = S + 2.0D0*G(I+1) + 4.0D0*G(I+2)
    END DO
    INTEGRAL = (S + G(1) + G(N-2) + 4.0D0*G(2))*H/3.0D0
  END IF
  INTEGRAL = INTEGRAL + 3.0D0*H/8.0D0 &
    & *(G(N-2)+3.0D0*G(N-1)+3.0D0*G(N)+G(N+1))
END IF
END SUBROUTINE SIMPSON_FROM_VECTOR

PURE INTEGER FUNCTION CUDA_SAFE_CHUNK(NVIB, NEED_PM) RESULT(CHUNK)
INTEGER, INTENT(IN) :: NVIB
LOGICAL, INTENT(IN) :: NEED_PM

IF (NVIB <= 0) THEN
  CHUNK = 0
ELSE IF (NVIB <= 250) THEN
  CHUNK = 256
ELSE IF (NVIB <= 350) THEN
  CHUNK = 128
ELSE IF (NVIB <= 500) THEN
  CHUNK = 64
ELSE IF (NVIB <= 800) THEN
  CHUNK = 32
ELSE IF (NVIB <= 1200) THEN
  CHUNK = 16
ELSE
  CHUNK = 8
END IF
IF (.NOT. NEED_PM .AND. NVIB <= 350) CHUNK = MAX(CHUNK, 128)
END FUNCTION CUDA_SAFE_CHUNK

ATTRIBUTES(DEVICE) SUBROUTINE DEV_BLOCK_REDUCE_COMPLEX(VAL, SH, TID, NTH)
COMPLEX(DP) :: VAL, SH(*)
INTEGER, VALUE :: TID, NTH
INTEGER :: STEP
SH(TID) = VAL
CALL SYNCTHREADS()
STEP = NTH/2
DO WHILE (STEP >= 1)
  IF (TID <= STEP) SH(TID) = SH(TID) + SH(TID+STEP)
  CALL SYNCTHREADS()
  STEP = STEP/2
END DO
VAL = SH(1)
CALL SYNCTHREADS()
END SUBROUTINE DEV_BLOCK_REDUCE_COMPLEX

ATTRIBUTES(DEVICE) SUBROUTINE DEV_ACCUM_LOG_PHASE(Z, LOGABS, PHASE, INFO)
COMPLEX(DP) :: Z
REAL(DP) :: LOGABS
COMPLEX(DP) :: PHASE
INTEGER :: INFO
REAL(DP) :: MAGZ
MAGZ = ABS(Z)
IF (MAGZ /= MAGZ .OR. MAGZ == 0.0D0) THEN
  INFO = -9100
  RETURN
END IF
LOGABS = LOGABS + LOG(MAGZ)
PHASE = PHASE * (Z / CMPLX(MAGZ, 0.0D0, KIND=DP))
END SUBROUTINE DEV_ACCUM_LOG_PHASE

ATTRIBUTES(DEVICE) SUBROUTINE DEV_NORMALIZE_PHASE(PHASE, INFO)
COMPLEX(DP) :: PHASE
INTEGER :: INFO
REAL(DP) :: MAGP
MAGP = ABS(PHASE)
IF (MAGP /= MAGP .OR. MAGP == 0.0D0) THEN
  INFO = -9102
  PHASE = (0.0D0,0.0D0)
ELSE
  PHASE = PHASE / CMPLX(MAGP, 0.0D0, KIND=DP)
END IF
END SUBROUTINE DEV_NORMALIZE_PHASE

ATTRIBUTES(DEVICE) SUBROUTINE DEV_APPLY_Z_TO_LOGPHASE(N, LOGABS, PHASE, ZV, INFO)
INTEGER, VALUE :: N
REAL(DP) :: LOGABS
COMPLEX(DP) :: PHASE
COMPLEX(DP) :: ZV(*)
INTEGER :: INFO, I
REAL(DP) :: MAGZ
COMPLEX(DP) :: UNITZ
DO I = 1, N
  MAGZ = ABS(ZV(I))
  IF (MAGZ /= MAGZ .OR. MAGZ == 0.0D0) THEN
    INFO = -9103
    PHASE = (0.0D0,0.0D0)
    RETURN
  END IF
  UNITZ = ZV(I) / CMPLX(MAGZ, 0.0D0, KIND=DP)
  LOGABS = LOGABS - 2.0D0*LOG(MAGZ)
  PHASE = PHASE / (UNITZ*UNITZ)
END DO
CALL DEV_NORMALIZE_PHASE(PHASE, INFO)
END SUBROUTINE DEV_APPLY_Z_TO_LOGPHASE

SUBROUTINE CUDA_APPLY_DET_PHASE_UNWRAP(GBASE, PHASE_RATIO, GCORR, NPTS, IERR)

INTEGER, INTENT(IN) :: NPTS
COMPLEX(DP), INTENT(IN) :: GBASE(:), PHASE_RATIO(:)
COMPLEX(DP), INTENT(OUT) :: GCORR(:)
INTEGER, INTENT(OUT) :: IERR
INTEGER :: I
REAL(DP) :: MAGP, THETA_RAW, THETA_PREV_RAW, THETA_UNWRAP, DELTA
COMPLEX(DP) :: SQPH

IERR = 0
IF (NPTS <= 0) RETURN
THETA_PREV_RAW = 0.0D0
THETA_UNWRAP = 0.0D0

DO I = 1, NPTS
  MAGP = ABS(PHASE_RATIO(I))
  IF (MAGP /= MAGP .OR. MAGP == 0.0D0) THEN
    IERR = -9810
    GCORR(I:NPTS) = (0.0D0, 0.0D0)
    RETURN
  END IF

  THETA_RAW = ATAN2(AIMAG(PHASE_RATIO(I)), REAL(PHASE_RATIO(I)))
  IF (I == 1) THEN
    THETA_UNWRAP = THETA_RAW
  ELSE
    DELTA = THETA_RAW - THETA_PREV_RAW
    DO WHILE (DELTA > PI_CUDA)
      DELTA = DELTA - 2.0D0*PI_CUDA
    END DO
    DO WHILE (DELTA <= -PI_CUDA)
      DELTA = DELTA + 2.0D0*PI_CUDA
    END DO
    THETA_UNWRAP = THETA_UNWRAP + DELTA
  END IF
  THETA_PREV_RAW = THETA_RAW

  SQPH = CMPLX(COS(0.5D0*THETA_UNWRAP), SIN(0.5D0*THETA_UNWRAP), KIND=DP)
  GCORR(I) = GBASE(I) * SQPH
END DO
END SUBROUTINE CUDA_APPLY_DET_PHASE_UNWRAP

SUBROUTINE CUDA_FILL_DIAG_AND_FLAT(N, OMEGA1, OMEGA2, JMAT, DMAT, ZMAT, O1, O2, JF, DV, ZV)
INTEGER, INTENT(IN) :: N
COMPLEX(DP), INTENT(IN) :: OMEGA1(:,:), OMEGA2(:,:), JMAT(:,:), DMAT(:,:), ZMAT(:,:)
COMPLEX(DP), INTENT(OUT) :: O1(:), O2(:), JF(:), DV(:), ZV(:)
INTEGER :: I
DO I = 1, N
  O1(I) = OMEGA1(I,I)
  O2(I) = OMEGA2(I,I)
  DV(I) = DMAT(I,1)
  ZV(I) = ZMAT(I,1)
END DO
JF = RESHAPE(JMAT(1:N,1:N), [N*N])
END SUBROUTINE CUDA_FILL_DIAG_AND_FLAT

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_SET_BATCH_PTR_PAIR(N, CHUNK, STRIDE, WORK, &
  OFF_A, OFF_C, APTR, CPTR)
INTEGER, VALUE :: N, CHUNK, STRIDE, OFF_A, OFF_C
COMPLEX(DP), DEVICE, TARGET :: WORK(*)
TYPE(c_devptr), DEVICE :: APTR(*), CPTR(*)
INTEGER :: B
B = (BLOCKIDX%X-1)*BLOCKDIM%X + THREADIDX%X
IF (B <= CHUNK) THEN
  APTR(B) = C_DEVLOC(WORK((B-1)*STRIDE + OFF_A))
  CPTR(B) = C_DEVLOC(WORK((B-1)*STRIDE + OFF_C))
END IF
END SUBROUTINE KERNEL_SET_BATCH_PTR_PAIR

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_SET_BATCH_PTR_GEMM_CONST(N, CHUNK, STRIDE, JMAT, WORK, &
  OFF_B, OFF_C, APTR, BPTR, CPTR)
INTEGER, VALUE :: N, CHUNK, STRIDE, OFF_B, OFF_C
COMPLEX(DP), DEVICE, TARGET :: JMAT(*), WORK(*)
TYPE(c_devptr), DEVICE :: APTR(*), BPTR(*), CPTR(*)
INTEGER :: B
B = (BLOCKIDX%X-1)*BLOCKDIM%X + THREADIDX%X
IF (B <= CHUNK) THEN
  APTR(B) = C_DEVLOC(JMAT(1))
  BPTR(B) = C_DEVLOC(WORK((B-1)*STRIDE + OFF_B))
  CPTR(B) = C_DEVLOC(WORK((B-1)*STRIDE + OFF_C))
END IF
END SUBROUTINE KERNEL_SET_BATCH_PTR_GEMM_CONST

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_SET_BATCH_PTR_GEMM_WORK(N, CHUNK, STRIDE, WORK, &
  OFF_A, OFF_B, OFF_C, APTR, BPTR, CPTR)
INTEGER, VALUE :: N, CHUNK, STRIDE, OFF_A, OFF_B, OFF_C
COMPLEX(DP), DEVICE, TARGET :: WORK(*)
TYPE(c_devptr), DEVICE :: APTR(*), BPTR(*), CPTR(*)
INTEGER :: B
B = (BLOCKIDX%X-1)*BLOCKDIM%X + THREADIDX%X
IF (B <= CHUNK) THEN
  APTR(B) = C_DEVLOC(WORK((B-1)*STRIDE + OFF_A))
  BPTR(B) = C_DEVLOC(WORK((B-1)*STRIDE + OFF_B))
  CPTR(B) = C_DEVLOC(WORK((B-1)*STRIDE + OFF_C))
END IF
END SUBROUTINE KERNEL_SET_BATCH_PTR_GEMM_WORK

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_ZERO_INT_ARRAY(NELM, ARR)
INTEGER, VALUE :: NELM
INTEGER, DEVICE :: ARR(*)
INTEGER :: B
B = (BLOCKIDX%X-1)*BLOCKDIM%X + THREADIDX%X
IF (B <= NELM) ARR(B) = 0
END SUBROUTINE KERNEL_ZERO_INT_ARRAY

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_LU_DET_FROM_PIVOT(N, CHUNK, STRIDE, WORK, OFF_LU, PIV, INFO_LU, LOGDET, PHASEDET)
INTEGER, VALUE :: N, CHUNK, STRIDE, OFF_LU
COMPLEX(DP), DEVICE :: WORK(*), PHASEDET(*)
REAL(DP), DEVICE :: LOGDET(*)
INTEGER, DEVICE :: PIV(*), INFO_LU(*)
INTEGER :: B, I, BASE, IP, LINFO
REAL(DP) :: LOGD
COMPLEX(DP) :: PHASED, AII
B = (BLOCKIDX%X-1)*BLOCKDIM%X + THREADIDX%X
IF (B > CHUNK) RETURN
IF (INFO_LU(B) /= 0) THEN
  LOGDET(B) = 0.0D0
  PHASEDET(B) = (0.0D0,0.0D0)
  RETURN
END IF
BASE = (B-1)*STRIDE + OFF_LU - 1
LOGD = 0.0D0
PHASED = (1.0D0,0.0D0)
LINFO = 0
DO I = 1, N
  AII = WORK(BASE + I + (I-1)*N)
  CALL DEV_ACCUM_LOG_PHASE(AII, LOGD, PHASED, LINFO)
  IF (LINFO /= 0) THEN
    INFO_LU(B) = LINFO
    LOGDET(B) = 0.0D0
    PHASEDET(B) = (0.0D0,0.0D0)
    RETURN
  END IF
  IP = PIV((B-1)*N + I)
  IF (IP /= I) PHASED = -PHASED
END DO
CALL DEV_NORMALIZE_PHASE(PHASED, LINFO)
IF (LINFO /= 0) THEN
  INFO_LU(B) = LINFO
  LOGDET(B) = 0.0D0
  PHASEDET(B) = (0.0D0,0.0D0)
ELSE
  LOGDET(B) = LOGD
  PHASEDET(B) = PHASED
END IF
END SUBROUTINE KERNEL_LU_DET_FROM_PIVOT

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_DUSCH_BUILD_FACTORS(N, CHUNK, GSTART, A0, H, BE, &
  EVINI, EVFIN, O1, O2, F1, G1, F2, G2)
INTEGER, VALUE :: N, CHUNK, GSTART
REAL(DP), VALUE :: A0, H, BE
COMPLEX(DP), DEVICE :: EVINI(*), EVFIN(*), O1(*), O2(*), F1(*), G1(*), F2(*), G2(*)
INTEGER :: IDX, B, I
REAL(DP) :: T
COMPLEX(DP) :: B1I, B2I
IDX = (BLOCKIDX%X-1)*BLOCKDIM%X + THREADIDX%X
IF (IDX > N*CHUNK) RETURN
I = MOD(IDX-1,N) + 1
B = (IDX-1)/N + 1
T = A0 + DBLE(GSTART + B - 2)*H
B1I = TANH((BE-IMG_CUDA*T)*EVINI(I)/2.0D0)
B2I = TANH(IMG_CUDA*T*EVFIN(I)/2.0D0)
F1(IDX) = O1(I) * B1I
G1(IDX) = O1(I) / B1I
F2(IDX) = O2(I) * B2I
G2(IDX) = O2(I) / B2I
END SUBROUTINE KERNEL_DUSCH_BUILD_FACTORS

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_DUSCH_BUILD_PM_FACTORS(N, CHUNK, O1, O2, F1, F2, P1, M1, P2, M2)
INTEGER, VALUE :: N, CHUNK
COMPLEX(DP), DEVICE :: O1(*), O2(*), F1(*), F2(*), P1(*), M1(*), P2(*), M2(*)
INTEGER :: IDX, I
IDX = (BLOCKIDX%X-1)*BLOCKDIM%X + THREADIDX%X
IF (IDX > N*CHUNK) RETURN
I = MOD(IDX-1,N) + 1
P1(IDX) = F1(IDX) / (O1(I)*O1(I))
M1(IDX) = 1.0D0 / F1(IDX)
P2(IDX) = F2(IDX) / (O2(I)*O2(I))
M2(IDX) = 1.0D0 / F2(IDX)
END SUBROUTINE KERNEL_DUSCH_BUILD_PM_FACTORS

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_DUSCH_BUILD_W01_LOGPHASE(SUBKIND, N, CHUNK, GSTART, A0, H, BE, &
  EVINI, EVFIN, O1, O2, ZV, LOGDETW01, PHDETW01)
INTEGER, VALUE :: SUBKIND, N, CHUNK, GSTART
REAL(DP), VALUE :: A0, H, BE
COMPLEX(DP), DEVICE :: EVINI(*), EVFIN(*), O1(*), O2(*), ZV(*), PHDETW01(*)
REAL(DP), DEVICE :: LOGDETW01(*)
INTEGER :: B, K, LINFO
REAL(DP) :: T, LDW
COMPLEX(DP) :: PHW, S1I, S2I, FAC
B = (BLOCKIDX%X-1)*BLOCKDIM%X + THREADIDX%X
IF (B > CHUNK) RETURN
T = A0 + DBLE(GSTART + B - 2)*H
LDW = 0.0D0
PHW = (1.0D0,0.0D0)
LINFO = 0
DO K = 1, N
  S1I = SINH((BE-IMG_CUDA*T)*EVINI(K))
  S2I = SINH(IMG_CUDA*T*EVFIN(K))
  FAC = O1(K)*O2(K)/S1I/S2I
  CALL DEV_ACCUM_LOG_PHASE(FAC, LDW, PHW, LINFO)
  IF (LINFO /= 0) EXIT
END DO
IF (LINFO /= 0) THEN
  LOGDETW01(B) = 0.0D0
  PHDETW01(B) = (0.0D0,0.0D0)
ELSE
  CALL DEV_NORMALIZE_PHASE(PHW, LINFO)
  IF (LINFO == 0) CALL DEV_APPLY_Z_TO_LOGPHASE(N, LDW, PHW, ZV, LINFO)
  IF (LINFO /= 0) THEN
    LOGDETW01(B) = 0.0D0
    PHDETW01(B) = (0.0D0,0.0D0)
  ELSE
    LOGDETW01(B) = LDW
    PHDETW01(B) = PHW
  END IF
END IF
END SUBROUTINE KERNEL_DUSCH_BUILD_W01_LOGPHASE

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_DUSCH_BUILD_W_BATCH_FACTORS_ELEM(SUBKIND, N, CHUNK, GSTART, A0, H, BE, &
  EVINI, EVFIN, O1, O2, JMAT, ZV, F1, G1, F2, G2, WORK, STRIDE_IN, LOGDETW01, PHDETW01)
INTEGER, VALUE :: SUBKIND, N, CHUNK, GSTART, STRIDE_IN
REAL(DP), VALUE :: A0, H, BE
COMPLEX(DP), DEVICE :: EVINI(*), EVFIN(*), O1(*), O2(*), JMAT(*), ZV(*), F1(*), G1(*), F2(*), G2(*), WORK(*), PHDETW01(*)
REAL(DP), DEVICE :: LOGDETW01(*)
INTEGER :: GID, B, IDX, I, J, K, N2, BASE, FBASE
COMPLEX(DP) :: SUM2, SUM3

GID = (BLOCKIDX%X-1)*BLOCKDIM%X + THREADIDX%X
N2 = N*N
IF (GID > CHUNK*N2) RETURN
B = (GID-1)/N2 + 1
IDX = MOD(GID-1,N2) + 1
I = MOD(IDX-1,N) + 1
J = (IDX-1)/N + 1
BASE = (B-1)*STRIDE_IN
FBASE = (B-1)*N

SUM2 = (0.0D0,0.0D0)
SUM3 = (0.0D0,0.0D0)
DO K = 1, N
  SUM2 = SUM2 + JMAT(K+(I-1)*N) * F2(FBASE+K) * JMAT(K+(J-1)*N)
  SUM3 = SUM3 + JMAT(K+(I-1)*N) * G2(FBASE+K) * JMAT(K+(J-1)*N)
END DO
IF (STRIDE_IN >= 10*N2) THEN
  WORK(BASE + 8*N2 + IDX) = SUM2
  WORK(BASE + 9*N2 + IDX) = SUM3
END IF
IF (I == J) THEN
  SUM2 = SUM2 + F1(FBASE+I)
  SUM3 = SUM3 + G1(FBASE+I)
END IF
WORK(BASE + IDX) = SUM2
WORK(BASE + N2 + IDX) = SUM3
END SUBROUTINE KERNEL_DUSCH_BUILD_W_BATCH_FACTORS_ELEM

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_DUSCH_BUILD_PM_BATCH_FACTORS_ELEM(N, CHUNK, JMAT, P1, M1, P2, M2, WORK, STRIDE_IN)
INTEGER, VALUE :: N, CHUNK, STRIDE_IN
COMPLEX(DP), DEVICE :: JMAT(*), P1(*), M1(*), P2(*), M2(*), WORK(*)
INTEGER :: GID, B, IDX, I, J, K, N2, BASE, FBASE
COMPLEX(DP) :: SUMP, SUMM

GID = (BLOCKIDX%X-1)*BLOCKDIM%X + THREADIDX%X
N2 = N*N
IF (GID > CHUNK*N2) RETURN
B = (GID-1)/N2 + 1
IDX = MOD(GID-1,N2) + 1
I = MOD(IDX-1,N) + 1
J = (IDX-1)/N + 1
BASE = (B-1)*STRIDE_IN
FBASE = (B-1)*N

SUMP = (0.0D0,0.0D0)
SUMM = (0.0D0,0.0D0)
DO K = 1, N
  SUMP = SUMP + JMAT(K+(I-1)*N) * P2(FBASE+K) * JMAT(K+(J-1)*N)
  SUMM = SUMM + JMAT(K+(I-1)*N) * M2(FBASE+K) * JMAT(K+(J-1)*N)
END DO
IF (I == J) THEN
  SUMP = SUMP + P1(FBASE+I)
  SUMM = SUMM + M1(FBASE+I)
END IF
WORK(BASE + 4*N2 + IDX) = SUMP
WORK(BASE + 5*N2 + IDX) = SUMM
END SUBROUTINE KERNEL_DUSCH_BUILD_PM_BATCH_FACTORS_ELEM

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_DUSCH_SCALE_J_TWO(N, CHUNK, JMAT, FACA, FACB, &
  WORK, STRIDE_IN, OFF_A, OFF_B)
INTEGER, VALUE :: N, CHUNK, STRIDE_IN, OFF_A, OFF_B
COMPLEX(DP), DEVICE :: JMAT(*), FACA(*), FACB(*), WORK(*)
INTEGER :: GID, B, IDX, I, N2, BASE, FBASE
GID = (BLOCKIDX%X-1)*BLOCKDIM%X + THREADIDX%X
N2 = N*N
IF (GID > CHUNK*N2) RETURN
B = (GID-1)/N2 + 1
IDX = MOD(GID-1,N2) + 1
I = MOD(IDX-1,N) + 1
BASE = (B-1)*STRIDE_IN
FBASE = (B-1)*N
WORK(BASE + OFF_A + IDX - 1) = FACA(FBASE + I)*JMAT(IDX)
WORK(BASE + OFF_B + IDX - 1) = FACB(FBASE + I)*JMAT(IDX)
END SUBROUTINE KERNEL_DUSCH_SCALE_J_TWO

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_DUSCH_FINISH_W_GEMM(SUBKIND, N, CHUNK, &
  O1, F1, G1, WORK, STRIDE_IN)
INTEGER, VALUE :: SUBKIND, N, CHUNK, STRIDE_IN
COMPLEX(DP), DEVICE :: O1(*), F1(*), G1(*), WORK(*)
INTEGER :: GID, B, IDX, I, J, N2, BASE, FBASE
COMPLEX(DP) :: SUM2, SUM3
GID = (BLOCKIDX%X-1)*BLOCKDIM%X + THREADIDX%X
N2 = N*N
IF (GID > CHUNK*N2) RETURN
B = (GID-1)/N2 + 1
IDX = MOD(GID-1,N2) + 1
I = MOD(IDX-1,N) + 1
J = (IDX-1)/N + 1
BASE = (B-1)*STRIDE_IN
FBASE = (B-1)*N
SUM2 = WORK(BASE + 2*N2 + IDX)
SUM3 = WORK(BASE + 3*N2 + IDX)
IF (STRIDE_IN >= 10*N2) THEN
  WORK(BASE + 8*N2 + IDX) = SUM2
  WORK(BASE + 9*N2 + IDX) = SUM3
END IF
IF (I == J) THEN
  SUM2 = SUM2 + F1(FBASE + I)
  SUM3 = SUM3 + G1(FBASE + I)
END IF
WORK(BASE + IDX) = SUM2
WORK(BASE + N2 + IDX) = SUM3
END SUBROUTINE KERNEL_DUSCH_FINISH_W_GEMM

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_DUSCH_FINISH_PM_GEMM(N, CHUNK, P1, M1, &
  WORK, STRIDE_IN)
INTEGER, VALUE :: N, CHUNK, STRIDE_IN
COMPLEX(DP), DEVICE :: P1(*), M1(*), WORK(*)
INTEGER :: GID, B, IDX, I, J, N2, BASE, FBASE
COMPLEX(DP) :: SUMP, SUMM
GID = (BLOCKIDX%X-1)*BLOCKDIM%X + THREADIDX%X
N2 = N*N
IF (GID > CHUNK*N2) RETURN
B = (GID-1)/N2 + 1
IDX = MOD(GID-1,N2) + 1
I = MOD(IDX-1,N) + 1
J = (IDX-1)/N + 1
BASE = (B-1)*STRIDE_IN
FBASE = (B-1)*N
SUMP = WORK(BASE + 6*N2 + IDX)
SUMM = WORK(BASE + 7*N2 + IDX)
IF (I == J) THEN
  SUMP = SUMP + P1(FBASE + I)
  SUMM = SUMM + M1(FBASE + I)
END IF
WORK(BASE + 4*N2 + IDX) = SUMP
WORK(BASE + 5*N2 + IDX) = SUMM
END SUBROUTINE KERNEL_DUSCH_FINISH_PM_GEMM

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_ISC_DUSCH_CUBLAS_FINAL_PAR(SUBKIND, N, CHUNK, GSTART, A0, H, BE, DE, &
  ISC_SOC_R, ISC_SOC_I, TRACE_O1_REAL, FULL_SVC_I, &
  USE_DHT_I, USE_FHT_I, USE_NA_I, USE_HN_I, EVINI, EVFIN, O1, O2, JMAT, DVEC, BCOUP, FHT, FNA, FHN, NACV, F1, G1, F2, G2, WORK, STRIDE_IN, &
  LOGDETW01, LOGDET2, LOGDET3, DETW01, DET2, DET3, INFO2, INFO3, INFOI2, INFOI3, INFOP, INFOM, INFOIP, INFOIM, &
  VNA, MNA, S_DSO_NA, S_HT_NA, &
  GDSO, GDHT, GHTHT, GNANA, GHTNA, G11, G12, G13, G15, G16, G22, G23, G24, G25, G26, PHASE_RATIO, INFO)
INTEGER, VALUE :: SUBKIND, N, CHUNK, GSTART, FULL_SVC_I, USE_DHT_I, USE_FHT_I, USE_NA_I, USE_HN_I, STRIDE_IN
REAL(DP), VALUE :: A0, H, BE, DE, ISC_SOC_R, ISC_SOC_I, TRACE_O1_REAL
COMPLEX(DP), DEVICE :: EVINI(*), EVFIN(*), O1(*), O2(*), JMAT(*), DVEC(*), BCOUP(*)
COMPLEX(DP), DEVICE :: FHT(*), FNA(*), FHN(*), NACV(*), F1(*), G1(*), F2(*), G2(*), WORK(*), DETW01(*), DET2(*), DET3(*)
COMPLEX(DP), DEVICE :: VNA(*), MNA(*)
COMPLEX(DP), VALUE :: S_DSO_NA, S_HT_NA
REAL(DP), DEVICE :: LOGDETW01(*), LOGDET2(*), LOGDET3(*)
COMPLEX(DP), DEVICE :: GDSO(*), GDHT(*), GHTHT(*), GNANA(*), GHTNA(*)
COMPLEX(DP), DEVICE :: G11(*), G12(*), G13(*), G15(*), G16(*), G22(*), G23(*), G24(*), G25(*), G26(*), PHASE_RATIO(*)
INTEGER, DEVICE :: INFO2(*), INFO3(*), INFOI2(*), INFOI3(*), INFOP(*), INFOM(*), INFOIP(*), INFOIM(*), INFO(*)
COMPLEX(DP), SHARED :: SH(BLOCK_SIZE)
INTEGER :: B, GIDX, N2, STRIDE, BASE, FBASE, OFFINV, OFFINV3, OFFV, OFFR, OFFIP, OFFIM, OFFRAW1, OFFRAW2
INTEGER :: IFAIL, TID, NTH, I, J, K, IDX, KP, LP, KK, LL, RR, SS, QQ
REAL(DP) :: T, PHASE_E
COMPLEX(DP) :: WORK1, WORK3, BASEG, QUAD, TRP, TRM, TERM, LOC, SUMV, TMP, B2K, B1K, TV, FR, LFT, EXPARG
REAL(DP) :: LOGHALF, LDW, LD2, LD3, MAGP
COMPLEX(DP) :: PHW, PH2, PH3, PHR
COMPLEX(DP) :: TERM_DHT, TERM_HT, TRACE_HT_P, TRACE_HT_M, TERM_NA, TRACE_NA_P, TRACE_NA_M
COMPLEX(DP) :: TERM_HN, TRACE_HN_P, TRACE_HN_M
COMPLEX(DP) :: ISC_SOC_C, V1, V2, L1E, L2E, A1E, A2E, R1, R2, W1, W2
COMPLEX(DP) :: L1A1_E, L2A2_E, GPLUS_E, GMINUS_E, MPP_E, TEMP1, TEMP2
COMPLEX(DP) :: TERM1F, TERM2F, TERM3F, TERM4F, TRACEF, HF1, HF2, MPQP, MQPQP
COMPLEX(DP) :: X1V, X2V, Y2V, X3V, X4V, Y4V, SUM1F, SUM2F, SUM3F, SUM4F

B = BLOCKIDX%X
IF (B > CHUNK) RETURN
TID = THREADIDX%X
NTH = BLOCKDIM%X
GIDX = GSTART + B - 1
N2 = N*N
STRIDE = STRIDE_IN
BASE = (B-1)*STRIDE
FBASE = (B-1)*N
OFFINV  = BASE + 2*N2 + 1
OFFINV3 = BASE + 3*N2 + 1
OFFV    = BASE + 4*N2 + 1
OFFR    = BASE + 5*N2 + 1
OFFIP   = BASE + 6*N2 + 1
OFFIM   = BASE + 7*N2 + 1
T = A0 + DBLE(GSTART + B - 2)*H

IFAIL = 0
IF (INFO2(B) /= 0) IFAIL = INFO2(B)
IF (IFAIL == 0 .AND. INFO3(B) /= 0) IFAIL = INFO3(B)
IF (IFAIL == 0 .AND. INFOI2(B) /= 0) IFAIL = INFOI2(B)
IF ((USE_FHT_I /= 0 .OR. USE_NA_I /= 0) .AND. IFAIL == 0 .AND. INFOI3(B) /= 0) IFAIL = INFOI3(B)
IF (USE_NA_I /= 0) THEN
  IF (IFAIL == 0 .AND. INFOP(B) /= 0) IFAIL = INFOP(B)
  IF (IFAIL == 0 .AND. INFOM(B) /= 0) IFAIL = INFOM(B)
  IF (IFAIL == 0 .AND. INFOIP(B) /= 0) IFAIL = INFOIP(B)
  IF (IFAIL == 0 .AND. INFOIM(B) /= 0) IFAIL = INFOIM(B)
END IF
IF (IFAIL /= 0) THEN
  IF (TID == 1) THEN
    INFO(GIDX) = IFAIL
    GDSO(GIDX) = (0.0D0,0.0D0); GDHT(GIDX) = (0.0D0,0.0D0); GHTHT(GIDX) = (0.0D0,0.0D0)
    GNANA(GIDX) = (0.0D0,0.0D0); GHTNA(GIDX) = (0.0D0,0.0D0); PHASE_RATIO(GIDX) = (0.0D0,0.0D0)
    G11(GIDX) = (0.0D0,0.0D0); G12(GIDX) = (0.0D0,0.0D0); G13(GIDX) = (0.0D0,0.0D0)
    G15(GIDX) = (0.0D0,0.0D0); G16(GIDX) = (0.0D0,0.0D0)
    G22(GIDX) = (0.0D0,0.0D0); G23(GIDX) = (0.0D0,0.0D0)
    G24(GIDX) = (0.0D0,0.0D0); G25(GIDX) = (0.0D0,0.0D0)
    G26(GIDX) = (0.0D0,0.0D0)
  END IF
  RETURN
END IF

DO I = TID, N, NTH
  SUMV = (0.0D0,0.0D0)
  DO K = 1, N
    SUMV = SUMV + JMAT(K+(I-1)*N) * F2(FBASE + K) * DVEC(K)
  END DO
  WORK(OFFV + I - 1) = SUMV
END DO
CALL SYNCTHREADS()

DO I = TID, N, NTH
  TMP = (0.0D0,0.0D0)
  DO J = 1, N
    TMP = TMP + WORK(OFFINV + I - 1 + (J-1)*N) * WORK(OFFV + J - 1)
  END DO
  WORK(OFFR + I - 1) = TMP
END DO
CALL SYNCTHREADS()

LOC = (0.0D0,0.0D0)
DO I = TID, N, NTH
  LOC = LOC + WORK(OFFV + I - 1) * WORK(OFFR + I - 1) - DVEC(I) * F2(FBASE + I) * DVEC(I)
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC, SH, TID, NTH)
QUAD = LOC

ISC_SOC_C = CMPLX(ISC_SOC_R, ISC_SOC_I, KIND=DP)
TERM_DHT = (0.0D0,0.0D0)
TERM_HT = (0.0D0,0.0D0); TRACE_HT_P = (0.0D0,0.0D0); TRACE_HT_M = (0.0D0,0.0D0)
TERM_NA = (0.0D0,0.0D0); TRACE_NA_P = (0.0D0,0.0D0); TRACE_NA_M = (0.0D0,0.0D0)
TERM_HN = (0.0D0,0.0D0); TRACE_HN_P = (0.0D0,0.0D0); TRACE_HN_M = (0.0D0,0.0D0)

IF (USE_DHT_I /= 0) THEN
  LOC = (0.0D0,0.0D0)
  DO I = TID, N, NTH

    LOC = LOC + (CONJG(ISC_SOC_C)*BCOUP(I))*WORK(OFFR + I - 1)
  END DO
  CALL DEV_BLOCK_REDUCE_COMPLEX(LOC, SH, TID, NTH)
  TERM_DHT = LOC
END IF

IF (USE_FHT_I /= 0) THEN
  LOC = (0.0D0,0.0D0)
  DO I = TID, N, NTH
    FR = (0.0D0,0.0D0)
    DO K = 1, N
      LFT = (0.0D0,0.0D0)
      DO J = 1, N
        LFT = LFT + WORK(OFFV + J - 1) * WORK(OFFINV + J - 1 + (K-1)*N)
      END DO
      FR = FR + FHT(I+(K-1)*N) * LFT
    END DO
    LOC = LOC + WORK(OFFR + I - 1) * FR
  END DO
  CALL DEV_BLOCK_REDUCE_COMPLEX(LOC, SH, TID, NTH)
  TERM_HT = LOC

  LOC = (0.0D0,0.0D0)
  DO IDX = TID, N2, NTH
    I = MOD(IDX-1,N) + 1
    K = (IDX-1)/N + 1
    LOC = LOC + FHT(I+(K-1)*N) * WORK(OFFINV + K - 1 + (I-1)*N)
  END DO
  CALL DEV_BLOCK_REDUCE_COMPLEX(LOC, SH, TID, NTH)
  TRACE_HT_P = LOC

  LOC = (0.0D0,0.0D0)
  DO IDX = TID, N2, NTH
    I = MOD(IDX-1,N) + 1
    K = (IDX-1)/N + 1
    LOC = LOC + FHT(I+(K-1)*N) * WORK(OFFINV3 + K - 1 + (I-1)*N)
  END DO
  CALL DEV_BLOCK_REDUCE_COMPLEX(LOC, SH, TID, NTH)
  TRACE_HT_M = LOC
END IF

TERM1F = (0.0D0,0.0D0)
IF (USE_NA_I /= 0) THEN

  LOC = (0.0D0,0.0D0)
  DO I = TID, N, NTH
    LOC = LOC + (CONJG(ISC_SOC_C)*NACV(I)) &
      *F1(FBASE + I)*WORK(OFFR + I - 1)
  END DO
  CALL DEV_BLOCK_REDUCE_COMPLEX(LOC, SH, TID, NTH)
  TERM1F = LOC

  LOC = (0.0D0,0.0D0)
  DO IDX = TID, N2, NTH
    I = MOD(IDX-1,N) + 1
    K = (IDX-1)/N + 1
    W1 = F1(FBASE + I)*WORK(OFFR + I - 1)
    W2 = F1(FBASE + K)*WORK(OFFR + K - 1)
    MPP_E = (0.0D0,0.0D0)
    IF (I == K) MPP_E = -F1(FBASE + I)+G1(FBASE + I)
    MPP_E = 0.5D0*(MPP_E &
      & +F1(FBASE + I)*WORK(OFFINV + I - 1 + (K-1)*N)*F1(FBASE + K) &
      & -G1(FBASE + I)*WORK(OFFINV3 + I - 1 + (K-1)*N)*G1(FBASE + K)) &
      & +W1*W2
    LOC = LOC + FNA(I+(K-1)*N)*MPP_E
  END DO
  CALL DEV_BLOCK_REDUCE_COMPLEX(LOC, SH, TID, NTH)
  TERM_NA = LOC
  TRACE_NA_P = (0.0D0,0.0D0)
  TRACE_NA_M = (0.0D0,0.0D0)
END IF

IF (USE_HN_I /= 0) THEN
  LOC = (0.0D0,0.0D0)
  DO IDX = TID, N2, NTH
    I = MOD(IDX-1,N) + 1
    J = (IDX-1)/N + 1
    GMINUS_E = 0.5D0*( &
      G1(FBASE + I)*WORK(OFFINV3 + I - 1 + (J-1)*N) &
      -F1(FBASE + I)*WORK(OFFINV + I - 1 + (J-1)*N))
    W1 = F1(FBASE + I)*WORK(OFFR + I - 1)
    GMINUS_E = GMINUS_E - W1*WORK(OFFR + J - 1)
    LOC = LOC - (CONJG(BCOUP(J))*NACV(I))*GMINUS_E
  END DO
  CALL DEV_BLOCK_REDUCE_COMPLEX(LOC, SH, TID, NTH)
  TERM_HN = LOC
  TRACE_HN_P = (0.0D0,0.0D0)
  TRACE_HN_M = (0.0D0,0.0D0)
END IF

IF (TID == 1) THEN
  INFO(GIDX) = 0
  LDW = LOGDETW01(B)
  LD2 = LOGDET2(B)
  LD3 = LOGDET3(B)
  PHW = DETW01(B)
  PH2 = DET2(B)
  PH3 = DET3(B)

  IF (LDW /= LDW .OR. LD2 /= LD2 .OR. LD3 /= LD3) THEN
    IFAIL = -9300
  ELSE
    MAGP = ABS(PHW)
    IF (MAGP /= MAGP .OR. MAGP == 0.0D0) IFAIL = -9301
    MAGP = ABS(PH2*PH3)
    IF (IFAIL == 0 .AND. (MAGP /= MAGP .OR. MAGP == 0.0D0)) IFAIL = -9302
  END IF
  IF (IFAIL == 0) THEN
    PHR = PHW/(PH2*PH3)
    CALL DEV_NORMALIZE_PHASE(PHR, IFAIL)
  END IF
  IF (IFAIL /= 0) THEN
    INFO(GIDX) = IFAIL
    GDSO(GIDX) = (0.0D0,0.0D0); GDHT(GIDX) = (0.0D0,0.0D0); GHTHT(GIDX) = (0.0D0,0.0D0)
    GNANA(GIDX) = (0.0D0,0.0D0); GHTNA(GIDX) = (0.0D0,0.0D0); PHASE_RATIO(GIDX) = (0.0D0,0.0D0)
    G11(GIDX) = (0.0D0,0.0D0); G12(GIDX) = (0.0D0,0.0D0); G13(GIDX) = (0.0D0,0.0D0)
    G15(GIDX) = (0.0D0,0.0D0); G16(GIDX) = (0.0D0,0.0D0)
    G22(GIDX) = (0.0D0,0.0D0); G23(GIDX) = (0.0D0,0.0D0)
    G24(GIDX) = (0.0D0,0.0D0); G25(GIDX) = (0.0D0,0.0D0)
    G26(GIDX) = (0.0D0,0.0D0)
    RETURN
  END IF
  LOGHALF = 0.5D0*(LDW - LD2 - LD3)
  PHASE_RATIO(GIDX) = PHR

  PHASE_E = DE
  EXPARG = QUAD + IMG_CUDA*T*PHASE_E + CMPLX(LOGHALF,0.0D0,KIND=DP)

  WORK3 = EXP(EXPARG)
  BASEG = WORK3
  GDSO(GIDX) = BASEG
  GDHT(GIDX) = (0.0D0,0.0D0); GHTHT(GIDX) = (0.0D0,0.0D0)
  GNANA(GIDX) = (0.0D0,0.0D0); GHTNA(GIDX) = (0.0D0,0.0D0)
  G11(GIDX) = (0.0D0,0.0D0); G12(GIDX) = (0.0D0,0.0D0); G13(GIDX) = (0.0D0,0.0D0)
  G15(GIDX) = (0.0D0,0.0D0); G16(GIDX) = (0.0D0,0.0D0)
  G22(GIDX) = (0.0D0,0.0D0); G23(GIDX) = (0.0D0,0.0D0)
  G24(GIDX) = (0.0D0,0.0D0); G25(GIDX) = (0.0D0,0.0D0)
  G26(GIDX) = (0.0D0,0.0D0)
  IF (USE_DHT_I /= 0) THEN
    GDHT(GIDX) = -2.0D0 * BASEG * TERM_DHT
  END IF
  IF (USE_FHT_I /= 0) THEN
    GHTHT(GIDX) = BASEG * (TERM_HT + 0.5D0*TRACE_HT_P - 0.5D0*TRACE_HT_M)
  END IF
  IF (USE_NA_I /= 0) THEN
    G11(GIDX) = -BASEG*TERM1F
    GNANA(GIDX) = BASEG * (TERM_NA + 0.5D0*TRACE_NA_P - 0.5D0*TRACE_NA_M)
  END IF
  IF (USE_HN_I /= 0) THEN
    GHTNA(GIDX) = 2.0D0*TERM_HN*BASEG
  END IF

END IF
END SUBROUTINE KERNEL_ISC_DUSCH_CUBLAS_FINAL_PAR

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_ISC_DUSCH_FULL_SVC_PAR(N, CHUNK, GSTART, &
  ISC_SOC_R, ISC_SOC_I, USE_HT_I, F1, G1, F2, G2, BCOUP, VNA, MNA, &
  S_DSO_NA, S_HT_NA, WORK, STRIDE_IN, GDSO, GNANA, &
  G12, G13, G15, G16, G22, G23, G24, G25, G26, INFO)
INTEGER, VALUE :: N, CHUNK, GSTART, USE_HT_I, STRIDE_IN
REAL(DP), VALUE :: ISC_SOC_R, ISC_SOC_I
COMPLEX(DP), VALUE :: S_DSO_NA, S_HT_NA
COMPLEX(DP), DEVICE :: F1(*), G1(*), F2(*), G2(*), BCOUP(*)
COMPLEX(DP), DEVICE :: VNA(*), MNA(*), WORK(*), GDSO(*), GNANA(*)
COMPLEX(DP), DEVICE :: G12(*), G13(*), G15(*), G16(*), G22(*), G23(*)
COMPLEX(DP), DEVICE :: G24(*), G25(*), G26(*)
INTEGER, DEVICE :: INFO(*)
COMPLEX(DP), SHARED :: SH(BLOCK_SIZE)
INTEGER :: B, GIDX, N2, BASE, FBASE, TID, NTH, IDX, I, J
INTEGER :: OFFINV, OFFINV3, OFFV, OFFR
INTEGER :: OFFTMP1, OFFTMP2, OFFTMP3, OFFTMP4
COMPLEX(DP) :: BASEG, ISC_SOC_C, LOC
COMPLEX(DP) :: W1, W2, MPP_E, GPLUS_E

B = BLOCKIDX%X
IF (B > CHUNK) RETURN
TID = THREADIDX%X
NTH = BLOCKDIM%X
GIDX = GSTART + B - 1
IF (INFO(GIDX) /= 0) RETURN
N2 = N*N
BASE = (B-1)*STRIDE_IN
FBASE = (B-1)*N
OFFINV = BASE + 2*N2 + 1
OFFINV3 = BASE + 3*N2 + 1
OFFV = BASE + 4*N2 + 1
OFFR = BASE + 5*N2 + 1
OFFTMP3 = BASE + 6*N2 + 1
OFFTMP4 = BASE + 7*N2 + 1
OFFTMP1 = BASE + 1
OFFTMP2 = BASE + N2 + 1
BASEG = GDSO(GIDX)
ISC_SOC_C = CMPLX(ISC_SOC_R, ISC_SOC_I, KIND=DP)

IF (TID == 1) THEN
  G12(GIDX) = (0.0D0,0.0D0); G13(GIDX) = (0.0D0,0.0D0)
  G15(GIDX) = (0.0D0,0.0D0); G16(GIDX) = (0.0D0,0.0D0)
  G22(GIDX) = (0.0D0,0.0D0); G23(GIDX) = (0.0D0,0.0D0)
  G24(GIDX) = (0.0D0,0.0D0); G25(GIDX) = (0.0D0,0.0D0)
  G26(GIDX) = (0.0D0,0.0D0)
END IF
CALL SYNCTHREADS()

IF (USE_HT_I == 0) RETURN

LOC = (0.0D0,0.0D0)
DO IDX = TID, N2, NTH
  I = MOD(IDX-1,N) + 1
  J = (IDX-1)/N + 1
  W1 = F1(FBASE + I)*WORK(OFFR + I - 1)
  GPLUS_E = (0.0D0,0.0D0)
  IF (I == J) GPLUS_E = (1.0D0,0.0D0)
  GPLUS_E = GPLUS_E &
    & -0.5D0*(F1(FBASE + I)*WORK(OFFINV + I - 1 + (J-1)*N) &
    & +G1(FBASE + I)*WORK(OFFINV3 + I - 1 + (J-1)*N)) &
    & -W1*WORK(OFFR + J - 1)
  LOC = LOC - (CONJG(ISC_SOC_C)*MNA(I + (J-1)*N))*GPLUS_E
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
IF (TID == 1) THEN
  G12(GIDX) = LOC*BASEG
  G13(GIDX) = (CONJG(ISC_SOC_C)*S_HT_NA)*BASEG
END IF

LOC = (0.0D0,0.0D0)
DO I = TID, N, NTH
  LOC = LOC - (CONJG(BCOUP(I))*S_HT_NA)*WORK(OFFR + I - 1)
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
IF (TID == 1) G16(GIDX) = LOC*BASEG

LOC = (0.0D0,0.0D0)
DO I = TID, N, NTH
  W1 = F1(FBASE + I)*WORK(OFFR + I - 1)
  LOC = LOC - (CONJG(VNA(I))*S_HT_NA)*W1
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
IF (TID == 1) THEN
  G23(GIDX) = CONJG(S_HT_NA)*S_HT_NA*BASEG
  G25(GIDX) = LOC*BASEG
END IF

LOC = (0.0D0,0.0D0)
DO IDX = TID, N2, NTH
  I = MOD(IDX-1,N) + 1
  J = (IDX-1)/N + 1
  W1 = F1(FBASE + J)*WORK(OFFR + J - 1)
  GPLUS_E = 0.5D0*(WORK(OFFTMP1 + J - 1 + (I-1)*N) &
    & +WORK(OFFTMP2 + J - 1 + (I-1)*N))-W1*WORK(OFFR + I - 1)
  LOC = LOC - (CONJG(MNA(J + (I-1)*N))*S_HT_NA)*GPLUS_E
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
IF (TID == 1) G26(GIDX) = LOC*BASEG

END SUBROUTINE KERNEL_ISC_DUSCH_FULL_SVC_PAR

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_ISC_FULL_G15_G24_FAST(N, CHUNK, GSTART, &
  F1, G1, BCOUP, VNA, MNA, WORK, STRIDE_IN, P1, M1, P2, M2, &
  GDSO, G15, G24, INFO)
INTEGER, VALUE :: N, CHUNK, GSTART, STRIDE_IN
COMPLEX(DP), DEVICE :: F1(*), G1(*), BCOUP(*), VNA(*), MNA(*), WORK(*)
COMPLEX(DP), DEVICE :: P1(*), M1(*), P2(*), M2(*), GDSO(*), G15(*), G24(*)
INTEGER, DEVICE :: INFO(*)
COMPLEX(DP), SHARED :: SH(BLOCK_SIZE)
INTEGER :: B, GIDX, N2, BASE, FBASE, TID, NTH, IDX, I, J, K
INTEGER :: OFFINV, OFFINV3, OFFR, OFFTMP1, OFFTMP2, OFFTMP3, OFFTMP4
REAL(DP) :: BR, BI, MR, MI, VR, VI
COMPLEX(DP) :: BASEG, LOC, LOC2, SBR, SBI, SVR, SVI
COMPLEX(DP) :: TEMP1, TEMP2, TEMP3, TEMP4, TEMP5
COMPLEX(DP) :: WJ, WK, TSUM, TDIFF, XR, XI
B = BLOCKIDX%X
IF (B > CHUNK) RETURN
GIDX = GSTART + B - 1
IF (INFO(GIDX) /= 0) RETURN
TID = THREADIDX%X
NTH = BLOCKDIM%X
N2 = N*N
BASE = (B-1)*STRIDE_IN
FBASE = (B-1)*N
OFFINV = BASE + 2*N2 + 1
OFFINV3 = BASE + 3*N2 + 1
OFFR = BASE + 5*N2 + 1
OFFTMP1 = BASE + 1
OFFTMP2 = BASE + N2 + 1
OFFTMP3 = BASE + 6*N2 + 1
OFFTMP4 = BASE + 7*N2 + 1
BASEG = GDSO(GIDX)

LOC = (0.0D0,0.0D0)
LOC2 = (0.0D0,0.0D0)
DO K = TID, N, NTH
  BR = REAL(BCOUP(K),KIND=DP)
  BI = AIMAG(BCOUP(K))
  LOC = LOC + BR*WORK(OFFR + K - 1)
  LOC2 = LOC2 + BI*WORK(OFFR + K - 1)
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC2,SH,TID,NTH)
SBR = LOC
SBI = LOC2

DO I = TID, N, NTH
  TEMP1 = (0.0D0,0.0D0)
  TEMP2 = (0.0D0,0.0D0)
  TEMP3 = (0.0D0,0.0D0)
  TEMP4 = (0.0D0,0.0D0)
  DO K = 1, N
    BR = REAL(BCOUP(K),KIND=DP)
    BI = AIMAG(BCOUP(K))
    TDIFF = WORK(OFFINV + I - 1 + (K-1)*N) &
      & -WORK(OFFINV3 + I - 1 + (K-1)*N)
    TEMP1 = TEMP1 + BR*TDIFF
    TEMP2 = TEMP2 + BI*TDIFF
    TDIFF = WORK(OFFTMP1 + I - 1 + (K-1)*N) &
      & -WORK(OFFTMP2 + I - 1 + (K-1)*N)
    TEMP3 = TEMP3 + BR*TDIFF
    TEMP4 = TEMP4 + BI*TDIFF
  END DO
  P1(FBASE + I) = TEMP1
  M1(FBASE + I) = TEMP2
  P2(FBASE + I) = TEMP3
  M2(FBASE + I) = TEMP4
END DO
CALL SYNCTHREADS()

LOC = (0.0D0,0.0D0)
DO IDX = TID, N2, NTH
  I = MOD(IDX-1,N) + 1
  J = (IDX-1)/N + 1
  WJ = F1(FBASE + J)*WORK(OFFR + J - 1)
  TSUM = WORK(OFFTMP1 + J - 1 + (I-1)*N) &
    & +WORK(OFFTMP2 + J - 1 + (I-1)*N)
  XR = WORK(OFFR + I - 1)*WJ*SBR &
    & +0.5D0*P1(FBASE + I)*WJ &
    & -0.5D0*WORK(OFFR + I - 1)*P2(FBASE + J) &
    & -0.5D0*TSUM*SBR
  XI = WORK(OFFR + I - 1)*WJ*SBI &
    & +0.5D0*M1(FBASE + I)*WJ &
    & -0.5D0*WORK(OFFR + I - 1)*M2(FBASE + J) &
    & -0.5D0*TSUM*SBI
  LOC = LOC - MNA(J + (I-1)*N)*(XR-IMG_CUDA*XI)
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
IF (TID == 1) G15(GIDX) = LOC*BASEG

LOC = (0.0D0,0.0D0)
LOC2 = (0.0D0,0.0D0)
DO I = TID, N, NTH
  TEMP1 = (0.0D0,0.0D0)
  TEMP2 = (0.0D0,0.0D0)
  TEMP3 = (0.0D0,0.0D0)
  TEMP4 = (0.0D0,0.0D0)
  DO K = 1, N
    TEMP1 = TEMP1+REAL(MNA(I + (K-1)*N),KIND=DP)*WORK(OFFR + K - 1)
    TEMP2 = TEMP2+AIMAG(MNA(I + (K-1)*N))*WORK(OFFR + K - 1)
    WK = F1(FBASE + K)*WORK(OFFR + K - 1)
    TEMP3 = TEMP3+REAL(MNA(K + (I-1)*N),KIND=DP)*WK
    TEMP4 = TEMP4+AIMAG(MNA(K + (I-1)*N))*WK
  END DO
  P1(FBASE + I) = TEMP1
  M1(FBASE + I) = TEMP2
  P2(FBASE + I) = TEMP3
  M2(FBASE + I) = TEMP4
  WJ = F1(FBASE + I)*WORK(OFFR + I - 1)
  LOC = LOC+REAL(VNA(I),KIND=DP)*WJ
  LOC2 = LOC2+AIMAG(VNA(I))*WJ
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC2,SH,TID,NTH)
SVR = LOC
SVI = LOC2

LOC = (0.0D0,0.0D0)
LOC2 = (0.0D0,0.0D0)
DO IDX = TID, N2, NTH
  I = MOD(IDX-1,N) + 1
  J = (IDX-1)/N + 1
  TSUM = WORK(OFFTMP1 + I - 1 + (J-1)*N) &
    & +WORK(OFFTMP2 + I - 1 + (J-1)*N)
  LOC = LOC+REAL(MNA(I + (J-1)*N),KIND=DP)*TSUM
  LOC2 = LOC2+AIMAG(MNA(I + (J-1)*N))*TSUM
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC2,SH,TID,NTH)
SBR = LOC
SBI = LOC2

LOC = (0.0D0,0.0D0)
DO I = TID, N, NTH
  TEMP1 = (0.0D0,0.0D0)
  TEMP2 = (0.0D0,0.0D0)
  TEMP3 = (0.0D0,0.0D0)
  TEMP4 = (0.0D0,0.0D0)
  WJ = F1(FBASE + I)*WORK(OFFR + I - 1)
  DO K = 1, N
    WK = F1(FBASE + K)*WORK(OFFR + K - 1)
    TSUM = (0.0D0,0.0D0)
    IF (I == K) TSUM = -F1(FBASE + I)+G1(FBASE + I)
    TSUM = 0.5D0*(TSUM &
      & +F1(FBASE + I)*WORK(OFFINV + I - 1 + (K-1)*N)*F1(FBASE + K) &
      & -G1(FBASE + I)*WORK(OFFINV3 + I - 1 + (K-1)*N)*G1(FBASE + K)) &
      & +WJ*WK
    TEMP1 = TEMP1+TSUM*P1(FBASE + K)
    TEMP2 = TEMP2+TSUM*M1(FBASE + K)
    TDIFF = WORK(OFFTMP1 + I - 1 + (K-1)*N) &
      & -WORK(OFFTMP2 + I - 1 + (K-1)*N)
    TEMP3 = TEMP3+TDIFF*P2(FBASE + K)
    TEMP4 = TEMP4+TDIFF*M2(FBASE + K)
  END DO
  LOC = LOC+CONJG(VNA(I))*(-TEMP1-IMG_CUDA*TEMP2 &
    & +0.5D0*(TEMP3+IMG_CUDA*TEMP4))
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
IF (TID == 1) G24(GIDX) = (LOC+0.5D0*(SVR-IMG_CUDA*SVI)*(SBR+IMG_CUDA*SBI))*BASEG
END SUBROUTINE KERNEL_ISC_FULL_G15_G24_FAST

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_ISC_FULL_G22_CORRECTED(N, CHUNK, GSTART, &
  F1, G1, MNA, WORK, STRIDE_IN, P1, M1, P2, M2, GDSO, G22, INFO)
INTEGER, VALUE :: N, CHUNK, GSTART, STRIDE_IN
COMPLEX(DP), DEVICE :: F1(*), G1(*), MNA(*), WORK(*)
COMPLEX(DP), DEVICE :: P1(*), M1(*), P2(*), M2(*), GDSO(*), G22(*)
INTEGER, DEVICE :: INFO(*)
COMPLEX(DP), SHARED :: SH(BLOCK_SIZE)
INTEGER :: B, GIDX, N2, BASE, FBASE, TID, NTH, IDX, I, J, K
INTEGER :: OFFINV, OFFINV3, OFFR, OFFR1, OFFR2, OFFK, OFFC, OFFRAW1, OFFRAW2
COMPLEX(DP) :: LOC, LOC2, LOC3, LOC4, TEMP1, TEMP2, TEMP3, TEMP4
COMPLEX(DP) :: W1, W2, MQPQP, BASEG

B = BLOCKIDX%X
IF (B > CHUNK) RETURN
GIDX = GSTART + B - 1
IF (INFO(GIDX) /= 0) RETURN
TID = THREADIDX%X
NTH = BLOCKDIM%X
N2 = N*N
BASE = (B-1)*STRIDE_IN
FBASE = (B-1)*N
OFFR1 = BASE + 1
OFFR2 = BASE + N2 + 1
OFFINV = BASE + 2*N2 + 1
OFFINV3 = BASE + 3*N2 + 1
OFFR = BASE + 5*N2 + 1
OFFK = BASE + 6*N2 + 1
OFFC = BASE + 7*N2 + 1
OFFRAW1 = BASE + 8*N2 + 1
OFFRAW2 = BASE + 9*N2 + 1
BASEG = GDSO(GIDX)

DO IDX = TID, N2, NTH
  I = MOD(IDX-1,N) + 1
  J = (IDX-1)/N + 1
  TEMP1 = (0.0D0,0.0D0)
  IF (I == J) TEMP1 = -F1(FBASE + I)+G1(FBASE + I)
  WORK(OFFK + IDX - 1) = TEMP1 &
    & +F1(FBASE + I)*WORK(OFFINV + IDX - 1)*F1(FBASE + J) &
    & -G1(FBASE + I)*WORK(OFFINV3 + IDX - 1)*G1(FBASE + J)
  WORK(OFFC + IDX - 1) = WORK(OFFINV + IDX - 1) &
    & -WORK(OFFINV3 + IDX - 1)
END DO
CALL SYNCTHREADS()

LOC = (0.0D0,0.0D0)
LOC2 = (0.0D0,0.0D0)
DO I = TID, N, NTH
  TEMP1 = (0.0D0,0.0D0)
  TEMP2 = (0.0D0,0.0D0)
  TEMP3 = (0.0D0,0.0D0)
  TEMP4 = (0.0D0,0.0D0)
  DO K = 1, N
    W1 = F1(FBASE + K)*WORK(OFFR + K - 1)
    TEMP1 = TEMP1+MNA(I + (K-1)*N)*WORK(OFFR + K - 1)
    TEMP2 = TEMP2+CONJG(MNA(I + (K-1)*N))*WORK(OFFR + K - 1)
    TEMP3 = TEMP3+MNA(K + (I-1)*N)*W1
    TEMP4 = TEMP4+CONJG(MNA(K + (I-1)*N))*W1
  END DO
  P1(FBASE + I) = TEMP1
  M1(FBASE + I) = TEMP2
  P2(FBASE + I) = TEMP3
  M2(FBASE + I) = TEMP4
  W1 = F1(FBASE + I)*WORK(OFFR + I - 1)
  LOC = LOC+W1*TEMP2
  LOC2 = LOC2+W1*TEMP1
END DO
LOC3 = (0.0D0,0.0D0)
LOC4 = (0.0D0,0.0D0)
DO IDX = TID, N2, NTH
  TEMP1 = WORK(OFFR1 + IDX - 1)+WORK(OFFR2 + IDX - 1)
  LOC3 = LOC3+CONJG(MNA(IDX))*TEMP1
  LOC4 = LOC4+MNA(IDX)*TEMP1
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC2,SH,TID,NTH)
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC3,SH,TID,NTH)
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC4,SH,TID,NTH)
MQPQP = 16.0D0*LOC*LOC2-8.0D0*LOC3*LOC2 &
  & -8.0D0*LOC*LOC4+4.0D0*LOC3*LOC4

LOC = (0.0D0,0.0D0)
LOC2 = (0.0D0,0.0D0)
LOC3 = (0.0D0,0.0D0)
LOC4 = (0.0D0,0.0D0)
DO I = TID, N, NTH
  TEMP1 = (0.0D0,0.0D0)
  TEMP2 = (0.0D0,0.0D0)
  TEMP3 = (0.0D0,0.0D0)
  TEMP4 = (0.0D0,0.0D0)
  DO K = 1, N
    TEMP1 = TEMP1+WORK(OFFC + I - 1 + (K-1)*N)*P2(FBASE + K)
    TEMP2 = TEMP2+(WORK(OFFR1 + K - 1 + (I-1)*N) &
      & -WORK(OFFR2 + K - 1 + (I-1)*N))*P1(FBASE + K)
    TEMP3 = TEMP3+(WORK(OFFR1 + I - 1 + (K-1)*N) &
      & -WORK(OFFR2 + I - 1 + (K-1)*N))*P2(FBASE + K)
    TEMP4 = TEMP4+WORK(OFFK + I - 1 + (K-1)*N)*P1(FBASE + K)
  END DO
  LOC = LOC+M2(FBASE + I)*TEMP1
  LOC2 = LOC2+M2(FBASE + I)*TEMP2
  LOC3 = LOC3+M1(FBASE + I)*TEMP3
  LOC4 = LOC4+M1(FBASE + I)*TEMP4
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC2,SH,TID,NTH)
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC3,SH,TID,NTH)
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC4,SH,TID,NTH)
MQPQP = MQPQP+8.0D0*LOC-8.0D0*LOC2-8.0D0*LOC3+8.0D0*LOC4

DO IDX = TID, N2, NTH
  I = MOD(IDX-1,N) + 1
  J = (IDX-1)/N + 1
  TEMP1 = (0.0D0,0.0D0)
  DO K = 1, N
    TEMP1 = TEMP1+WORK(OFFK + I - 1 + (K-1)*N)*MNA(K + (J-1)*N)
  END DO
  WORK(OFFRAW1 + IDX - 1) = TEMP1
END DO
CALL SYNCTHREADS()
DO IDX = TID, N2, NTH
  I = MOD(IDX-1,N) + 1
  J = (IDX-1)/N + 1
  TEMP1 = (0.0D0,0.0D0)
  DO K = 1, N
    TEMP1 = TEMP1+WORK(OFFRAW1 + I - 1 + (K-1)*N) &
      & *WORK(OFFC + K - 1 + (J-1)*N)
  END DO
  WORK(OFFRAW2 + IDX - 1) = TEMP1
END DO
CALL SYNCTHREADS()
LOC = (0.0D0,0.0D0)
DO IDX = TID, N2, NTH
  LOC = LOC+CONJG(MNA(IDX))*WORK(OFFRAW2 + IDX - 1)
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
MQPQP = MQPQP+4.0D0*LOC

DO IDX = TID, N2, NTH
  I = MOD(IDX-1,N) + 1
  J = (IDX-1)/N + 1
  TEMP1 = (0.0D0,0.0D0)
  TEMP2 = (0.0D0,0.0D0)
  DO K = 1, N
    TEMP3 = WORK(OFFR1 + J - 1 + (K-1)*N) &
      & -WORK(OFFR2 + J - 1 + (K-1)*N)
    TEMP1 = TEMP1+MNA(I + (K-1)*N)*TEMP3
    TEMP2 = TEMP2+CONJG(MNA(I + (K-1)*N))*TEMP3
  END DO
  WORK(OFFRAW1 + IDX - 1) = TEMP1
  WORK(OFFRAW2 + IDX - 1) = TEMP2
END DO
CALL SYNCTHREADS()
LOC = (0.0D0,0.0D0)
DO IDX = TID, N2, NTH
  I = MOD(IDX-1,N) + 1
  J = (IDX-1)/N + 1
  LOC = LOC+WORK(OFFRAW1 + IDX - 1) &
    & *WORK(OFFRAW2 + J - 1 + (I-1)*N)
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
IF (TID == 1) G22(GIDX) = 0.0625D0*(MQPQP+4.0D0*LOC)*BASEG
END SUBROUTINE KERNEL_ISC_FULL_G22_CORRECTED

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_IC13_CUBLAS_FINAL_PAR(N, CHUNK, GSTART, A0, H, BE, DE, &
  EVINI, EVFIN, O1, O2, JMAT, DVEC, FMAT, F1, G1, F2, G2, WORK, LOGDETW01, LOGDET2, LOGDET3, DETW01, DET2, DET3, &
  INFO2, INFO3, INFOI2, INFOI3, INFOP, INFOM, INFOIP, INFOIM, GOUT, PHASE_RATIO, INFO)
INTEGER, VALUE :: N, CHUNK, GSTART
REAL(DP), VALUE :: A0, H, BE, DE
COMPLEX(DP), DEVICE :: EVINI(*), EVFIN(*), O1(*), O2(*), JMAT(*), DVEC(*), FMAT(*), F1(*), G1(*), F2(*), G2(*), WORK(*)
COMPLEX(DP), DEVICE :: DETW01(*), DET2(*), DET3(*), GOUT(*), PHASE_RATIO(*)
REAL(DP), DEVICE :: LOGDETW01(*), LOGDET2(*), LOGDET3(*)
INTEGER, DEVICE :: INFO2(*), INFO3(*), INFOI2(*), INFOI3(*), INFOP(*), INFOM(*), INFOIP(*), INFOIM(*), INFO(*)
COMPLEX(DP), SHARED :: SH(BLOCK_SIZE)
INTEGER :: B, GIDX, N2, STRIDE, BASE, FBASE, OFFINV, OFFV, OFFR, OFFIP, OFFIM
INTEGER :: IFAIL, TID, NTH, I, J, K, IDX
REAL(DP) :: T
COMPLEX(DP) :: QUAD, WORK1, WORK3, TERM, TRP, TRM, LOC, SUMV, TMP, B2K, B1K, TV, FR, LFT, EXPARG
REAL(DP) :: LOGHALF, LDW, LD2, LD3, MAGP
COMPLEX(DP) :: PHW, PH2, PH3, PHR

B = BLOCKIDX%X
IF (B > CHUNK) RETURN
TID = THREADIDX%X
NTH = BLOCKDIM%X
GIDX = GSTART + B - 1
N2 = N*N
STRIDE = 8*N2
BASE = (B-1)*STRIDE
FBASE = (B-1)*N
OFFINV = BASE + 2*N2 + 1
OFFV   = BASE + 4*N2 + 1
OFFR   = BASE + 5*N2 + 1
OFFIP  = BASE + 6*N2 + 1
OFFIM  = BASE + 7*N2 + 1
T = A0 + DBLE(GSTART + B - 2)*H

IFAIL = 0
IF (INFO2(B) /= 0) IFAIL = INFO2(B)
IF (IFAIL == 0 .AND. INFO3(B) /= 0) IFAIL = INFO3(B)
IF (IFAIL == 0 .AND. INFOI2(B) /= 0) IFAIL = INFOI2(B)
IF (IFAIL == 0 .AND. INFOI3(B) /= 0) IFAIL = INFOI3(B)
IF (IFAIL == 0 .AND. INFOP(B) /= 0) IFAIL = INFOP(B)
IF (IFAIL == 0 .AND. INFOM(B) /= 0) IFAIL = INFOM(B)
IF (IFAIL == 0 .AND. INFOIP(B) /= 0) IFAIL = INFOIP(B)
IF (IFAIL == 0 .AND. INFOIM(B) /= 0) IFAIL = INFOIM(B)
IF (IFAIL /= 0) THEN
  IF (TID == 1) THEN
    INFO(GIDX) = IFAIL
    GOUT(GIDX) = (0.0D0,0.0D0)
    PHASE_RATIO(GIDX) = (0.0D0,0.0D0)
  END IF
  RETURN
END IF

DO I = TID, N, NTH
  SUMV = (0.0D0,0.0D0)
  DO K = 1, N
    SUMV = SUMV + JMAT(K+(I-1)*N) * F2(FBASE + K) * DVEC(K)
  END DO
  WORK(OFFV + I - 1) = SUMV
END DO
CALL SYNCTHREADS()

DO I = TID, N, NTH
  TMP = (0.0D0,0.0D0)
  DO J = 1, N
    TMP = TMP + WORK(OFFINV + I - 1 + (J-1)*N) * WORK(OFFV + J - 1)
  END DO
  WORK(OFFR + I - 1) = TMP
END DO
CALL SYNCTHREADS()

LOC = (0.0D0,0.0D0)
DO I = TID, N, NTH
  LOC = LOC + WORK(OFFV + I - 1) * WORK(OFFR + I - 1) - DVEC(I) * F2(FBASE + I) * DVEC(I)
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC, SH, TID, NTH)
QUAD = LOC

LOC = (0.0D0,0.0D0)
DO I = TID, N, NTH
  FR = (0.0D0,0.0D0)
  DO K = 1, N
    TV = F1(FBASE + K) * WORK(OFFR + K - 1)
    FR = FR + FMAT(I+(K-1)*N) * TV
  END DO
  FR = F1(FBASE + I) * FR
  LFT = (0.0D0,0.0D0)
  DO J = 1, N
    LFT = LFT + WORK(OFFV + J - 1) * WORK(OFFINV + I - 1 + (J-1)*N)
  END DO
  LOC = LOC + LFT * FR
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC, SH, TID, NTH)
TERM = LOC

LOC = (0.0D0,0.0D0)
DO IDX = TID, N2, NTH
  I = MOD(IDX-1,N) + 1
  K = (IDX-1)/N + 1
  LOC = LOC + FMAT(I+(K-1)*N) * WORK(OFFIP + K - 1 + (I-1)*N)
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC, SH, TID, NTH)
TRP = LOC

LOC = (0.0D0,0.0D0)
DO IDX = TID, N2, NTH
  I = MOD(IDX-1,N) + 1
  K = (IDX-1)/N + 1
  LOC = LOC + FMAT(I+(K-1)*N) * WORK(OFFIM + K - 1 + (I-1)*N)
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC, SH, TID, NTH)
TRM = LOC

IF (TID == 1) THEN
  INFO(GIDX) = 0
  LDW = LOGDETW01(B)
  LD2 = LOGDET2(B)
  LD3 = LOGDET3(B)
  PHW = DETW01(B)
  PH2 = DET2(B)
  PH3 = DET3(B)

  IF (LDW /= LDW .OR. LD2 /= LD2 .OR. LD3 /= LD3) THEN
    IFAIL = -9200
  ELSE
    MAGP = ABS(PHW)
    IF (MAGP /= MAGP .OR. MAGP == 0.0D0) IFAIL = -9201
    MAGP = ABS(PH2*PH3)
    IF (IFAIL == 0 .AND. (MAGP /= MAGP .OR. MAGP == 0.0D0)) IFAIL = -9202
  END IF
  IF (IFAIL == 0) THEN
    PHR = PHW/(PH2*PH3)
    CALL DEV_NORMALIZE_PHASE(PHR, IFAIL)
  END IF
  IF (IFAIL /= 0) THEN
    INFO(GIDX) = IFAIL
    GOUT(GIDX) = (0.0D0,0.0D0)
    PHASE_RATIO(GIDX) = (0.0D0,0.0D0)
    RETURN
  END IF
  LOGHALF = 0.5D0*(LDW - LD2 - LD3)
  EXPARG = QUAD + IMG_CUDA*T*DE + CMPLX(LOGHALF,0.0D0,KIND=DP)

  WORK3 = EXP(EXPARG)
  GOUT(GIDX) = WORK3 * (TERM + 0.5D0*TRP - 0.5D0*TRM)
  PHASE_RATIO(GIDX) = PHR
END IF
END SUBROUTINE KERNEL_IC13_CUBLAS_FINAL_PAR

SUBROUTINE CUDA_ZBATCH_FACTOR_INVERT_DET(HBLAS, N, CHUNK, STRIDE, D_WORK, OFF_A, OFF_INV, &
  D_PTR_A, D_PTR_C, D_PIV, D_INFO_LU, D_INFO_INV, D_LOGDET, D_PHASEDET, IERR)
TYPE(cublasHandle), INTENT(IN) :: HBLAS
INTEGER, INTENT(IN) :: N, CHUNK, STRIDE, OFF_A, OFF_INV
COMPLEX(DP), DEVICE, TARGET :: D_WORK(:)
TYPE(c_devptr), DEVICE :: D_PTR_A(:), D_PTR_C(:)
INTEGER, DEVICE :: D_PIV(:), D_INFO_LU(:), D_INFO_INV(:)
REAL(DP), DEVICE :: D_LOGDET(:)
COMPLEX(DP), DEVICE :: D_PHASEDET(:)
INTEGER, INTENT(OUT) :: IERR
INTEGER :: ISTAT
TYPE(DIM3) :: GRIDP, BLOCKP
IERR = 0
BLOCKP = DIM3(128,1,1)
GRIDP = DIM3((CHUNK+127)/128,1,1)
CALL KERNEL_SET_BATCH_PTR_PAIR<<<GRIDP, BLOCKP>>>(N, CHUNK, STRIDE, D_WORK, OFF_A, OFF_INV, D_PTR_A, D_PTR_C)
ISTAT = cudaGetLastError()
IF (ISTAT /= 0) THEN
  IERR = 90000 + ISTAT
  RETURN
END IF
ISTAT = cublasZgetrfBatched(HBLAS, N, D_PTR_A, N, D_PIV, D_INFO_LU, CHUNK)
IF (ISTAT /= 0) THEN
  IERR = 100000 + ISTAT
  RETURN
END IF
CALL KERNEL_LU_DET_FROM_PIVOT<<<GRIDP, BLOCKP>>>(N, CHUNK, STRIDE, D_WORK, OFF_A, D_PIV, D_INFO_LU, D_LOGDET, D_PHASEDET)
ISTAT = cudaGetLastError()
IF (ISTAT /= 0) THEN
  IERR = 91000 + ISTAT
  RETURN
END IF
ISTAT = cublasZgetriBatched(HBLAS, N, D_PTR_A, N, D_PIV, D_PTR_C, N, D_INFO_INV, CHUNK)
IF (ISTAT /= 0) THEN
  IERR = 110000 + ISTAT
END IF
END SUBROUTINE CUDA_ZBATCH_FACTOR_INVERT_DET

SUBROUTINE CUDA_ZBATCH_FACTOR_DET_ONLY(HBLAS, N, CHUNK, STRIDE, D_WORK, OFF_A, OFF_INV, &
  D_PTR_A, D_PTR_C, D_PIV, D_INFO_LU, D_INFO_INV, D_LOGDET, D_PHASEDET, IERR)
TYPE(cublasHandle), INTENT(IN) :: HBLAS
INTEGER, INTENT(IN) :: N, CHUNK, STRIDE, OFF_A, OFF_INV
COMPLEX(DP), DEVICE, TARGET :: D_WORK(:)
TYPE(c_devptr), DEVICE :: D_PTR_A(:), D_PTR_C(:)
INTEGER, DEVICE :: D_PIV(:), D_INFO_LU(:), D_INFO_INV(:)
REAL(DP), DEVICE :: D_LOGDET(:)
COMPLEX(DP), DEVICE :: D_PHASEDET(:)
INTEGER, INTENT(OUT) :: IERR
INTEGER :: ISTAT
TYPE(DIM3) :: GRIDP, BLOCKP
IERR = 0
BLOCKP = DIM3(128,1,1)
GRIDP = DIM3((CHUNK+127)/128,1,1)

CALL KERNEL_SET_BATCH_PTR_PAIR<<<GRIDP, BLOCKP>>>(N, CHUNK, STRIDE, D_WORK, OFF_A, OFF_A, D_PTR_A, D_PTR_C)
ISTAT = cudaGetLastError()
IF (ISTAT /= 0) THEN
  IERR = 90000 + ISTAT
  RETURN
END IF
ISTAT = cublasZgetrfBatched(HBLAS, N, D_PTR_A, N, D_PIV, D_INFO_LU, CHUNK)
IF (ISTAT /= 0) THEN
  IERR = 100000 + ISTAT
  RETURN
END IF
CALL KERNEL_LU_DET_FROM_PIVOT<<<GRIDP, BLOCKP>>>(N, CHUNK, STRIDE, D_WORK, OFF_A, D_PIV, D_INFO_LU, D_LOGDET, D_PHASEDET)
ISTAT = cudaGetLastError()
IF (ISTAT /= 0) THEN
  IERR = 91000 + ISTAT
  RETURN
END IF
CALL KERNEL_ZERO_INT_ARRAY<<<GRIDP, BLOCKP>>>(CHUNK, D_INFO_INV)
ISTAT = cudaGetLastError()
IF (ISTAT /= 0) THEN
  IERR = 91500 + ISTAT
END IF
END SUBROUTINE CUDA_ZBATCH_FACTOR_DET_ONLY

