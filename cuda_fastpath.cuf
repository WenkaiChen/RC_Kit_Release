SUBROUTINE CUDA_ZBATCH_GEMM_WORK(HBLAS, N, CHUNK, STRIDE, D_WORK, &
  OFF_A, OFF_B, OFF_C, TRANSA, TRANSB, D_PTR_A, D_PTR_B, D_PTR_C, IERR)
TYPE(cublasHandle), INTENT(IN) :: HBLAS
INTEGER, INTENT(IN) :: N, CHUNK, STRIDE, OFF_A, OFF_B, OFF_C, TRANSA, TRANSB
COMPLEX(DP), DEVICE, TARGET :: D_WORK(:)
TYPE(c_devptr), DEVICE :: D_PTR_A(:), D_PTR_B(:), D_PTR_C(:)
INTEGER, INTENT(OUT) :: IERR
INTEGER :: ISTAT
COMPLEX(DP) :: ALPHA, BETA
