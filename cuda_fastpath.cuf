IF (ISTAT /= 0) IERR = 117000 + ISTAT
END SUBROUTINE CUDA_ZBATCH_GEMM_WORK

ATTRIBUTES(GLOBAL) SUBROUTINE KERNEL_ISC_NEGATIVE_CROSS(N, CHUNK, GSTART, NPTS, &
  USE_HT_I, USE_NA_I, FULL_SVC_I, ISC_SOC_C, S_HT_NA, F1, G1, BCOUP, NACV, VNA, MNA, &
  WORK, STRIDE_IN, P1, P2, GDSO, GNEG, INFO)
INTEGER, VALUE :: N, CHUNK, GSTART, NPTS, USE_HT_I, USE_NA_I, FULL_SVC_I, STRIDE_IN
COMPLEX(DP), VALUE :: ISC_SOC_C, S_HT_NA
COMPLEX(DP), DEVICE :: F1(*), G1(*), BCOUP(*), NACV(*), VNA(*), MNA(*), WORK(*)
COMPLEX(DP), DEVICE :: P1(*), P2(*), GDSO(*), GNEG(NPTS,15)
INTEGER, DEVICE :: INFO(*)
COMPLEX(DP), SHARED :: SH(BLOCK_SIZE)
INTEGER :: B, GIDX, BASE, FBASE, OFFINV, OFFINV3, OFFR, TID, NTH, I, J, K, IDX
COMPLEX(DP) :: BASEG, LOC, LOC2, LOC3, LOC4, RI, RJ, RK, WI, WK, FI, GI, AIJ, BIJ
COMPLEX(DP) :: GPLUS_E, GMINUS_E, TSUM, TDIFF, MPP_E, TEMP1, TEMP2, SBR, SVR
B = BLOCKIDX%X
IF (B > CHUNK) RETURN
GIDX = GSTART+B-1
IF (INFO(GIDX) /= 0) RETURN
TID = THREADIDX%X
NTH = BLOCKDIM%X
BASE = (B-1)*STRIDE_IN
FBASE = (B-1)*N
OFFINV = BASE+2*N*N+1
OFFINV3 = BASE+3*N*N+1
OFFR = BASE+5*N*N+1
BASEG = CONJG(GDSO(GIDX))

LOC = (0.0D0,0.0D0)
LOC2 = (0.0D0,0.0D0)
LOC3 = (0.0D0,0.0D0)
LOC4 = (0.0D0,0.0D0)
DO I = TID, N, NTH
  RI = CONJG(WORK(OFFR+I-1))
  WI = CONJG(F1(FBASE+I))*RI
  IF (USE_HT_I /= 0) LOC = LOC-CONJG(ISC_SOC_C)*BCOUP(I)*RI
  IF (USE_NA_I /= 0) THEN
    LOC2 = LOC2-CONJG(ISC_SOC_C)*NACV(I)*WI
  END IF
  IF (FULL_SVC_I /= 0 .AND. USE_HT_I /= 0 .AND. USE_NA_I /= 0) THEN
    LOC3 = LOC3-CONJG(BCOUP(I))*S_HT_NA*RI
    LOC4 = LOC4-CONJG(VNA(I))*S_HT_NA*WI
  END IF
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC2,SH,TID,NTH)
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC3,SH,TID,NTH)
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC4,SH,TID,NTH)
IF (TID == 1) THEN
  GNEG(GIDX,2) = LOC*BASEG
  GNEG(GIDX,4) = LOC2*BASEG
  GNEG(GIDX,9) = LOC3*BASEG
  GNEG(GIDX,14) = LOC4*BASEG
  IF (FULL_SVC_I /= 0 .AND. USE_HT_I /= 0 .AND. USE_NA_I /= 0) &
    GNEG(GIDX,6) = CONJG(ISC_SOC_C)*S_HT_NA*BASEG
END IF
IF (USE_HT_I == 0 .OR. USE_NA_I == 0) RETURN

LOC = (0.0D0,0.0D0)
LOC2 = (0.0D0,0.0D0)
LOC3 = (0.0D0,0.0D0)
DO IDX = TID, N*N, NTH
  I = MOD(IDX-1,N)+1
  J = (IDX-1)/N+1
  FI = CONJG(F1(FBASE+I))
  GI = CONJG(G1(FBASE+I))
  WI = FI*CONJG(WORK(OFFR+I-1))
  RJ = CONJG(WORK(OFFR+J-1))
  AIJ = CONJG(WORK(OFFINV+IDX-1))
  BIJ = CONJG(WORK(OFFINV3+IDX-1))
  GPLUS_E = -0.5D0*(FI*AIJ+GI*BIJ)-WI*RJ
  IF (I == J) GPLUS_E = GPLUS_E+1.0D0
  GMINUS_E = 0.5D0*(-FI*AIJ+GI*BIJ)-WI*RJ
  LOC = LOC-CONJG(BCOUP(J))*NACV(I)*GMINUS_E
  IF (FULL_SVC_I /= 0) THEN
    LOC2 = LOC2-CONJG(ISC_SOC_C)*MNA(IDX)*GPLUS_E
    LOC3 = LOC3-CONJG(MNA(IDX))*S_HT_NA*GPLUS_E
  END IF
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC2,SH,TID,NTH)
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC3,SH,TID,NTH)
IF (TID == 1) THEN
  GNEG(GIDX,7) = LOC*BASEG
  GNEG(GIDX,5) = LOC2*BASEG
  GNEG(GIDX,15) = LOC3*BASEG
END IF
IF (FULL_SVC_I == 0) RETURN

LOC = (0.0D0,0.0D0)
DO I = TID, N, NTH
  RI = CONJG(WORK(OFFR+I-1))
  LOC = LOC+CONJG(BCOUP(I))*RI
  FI = CONJG(F1(FBASE+I))
  GI = CONJG(G1(FBASE+I))
  TEMP1 = (0.0D0,0.0D0)
  TEMP2 = (0.0D0,0.0D0)
  DO K = 1, N
    AIJ = CONJG(WORK(OFFINV+I-1+(K-1)*N))
    BIJ = CONJG(WORK(OFFINV3+I-1+(K-1)*N))
    TEMP1 = TEMP1+(AIJ-BIJ)*CONJG(BCOUP(K))
    TEMP2 = TEMP2+(-FI*AIJ+GI*BIJ)*CONJG(BCOUP(K))
  END DO
  P1(FBASE+I) = TEMP1
  P2(FBASE+I) = TEMP2
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
SBR = LOC
LOC = (0.0D0,0.0D0)
DO IDX = TID, N*N, NTH
  I = MOD(IDX-1,N)+1
  J = (IDX-1)/N+1
  FI = CONJG(F1(FBASE+I))
  GI = CONJG(G1(FBASE+I))
  WI = FI*CONJG(WORK(OFFR+I-1))
  RJ = CONJG(WORK(OFFR+J-1))
  TSUM = -FI*CONJG(WORK(OFFINV+IDX-1))-GI*CONJG(WORK(OFFINV3+IDX-1))
  IF (I == J) TSUM = TSUM+2.0D0
  LOC = LOC-MNA(IDX)*(RJ*WI*SBR+0.5D0*P1(FBASE+J)*WI &
    -0.5D0*RJ*P2(FBASE+I)-0.5D0*TSUM*SBR)
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
IF (TID == 1) GNEG(GIDX,8) = LOC*BASEG

LOC = (0.0D0,0.0D0)
LOC2 = (0.0D0,0.0D0)
DO I = TID, N, NTH
  FI = CONJG(F1(FBASE+I))
  GI = CONJG(G1(FBASE+I))
  WI = FI*CONJG(WORK(OFFR+I-1))
  LOC = LOC+CONJG(VNA(I))*WI
  TEMP1 = (0.0D0,0.0D0)
  TEMP2 = (0.0D0,0.0D0)
  DO K = 1, N
    RK = CONJG(WORK(OFFR+K-1))
    WK = CONJG(F1(FBASE+K))*RK
    TEMP1 = TEMP1+MNA(I+(K-1)*N)*RK
    TEMP2 = TEMP2+MNA(K+(I-1)*N)*WK
    TSUM = -FI*CONJG(WORK(OFFINV+I-1+(K-1)*N)) &
      -GI*CONJG(WORK(OFFINV3+I-1+(K-1)*N))
    IF (I == K) TSUM = TSUM+2.0D0
    LOC2 = LOC2+MNA(I+(K-1)*N)*TSUM
  END DO
  P1(FBASE+I) = TEMP1
  P2(FBASE+I) = TEMP2
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC2,SH,TID,NTH)
SVR = LOC
SBR = LOC2
LOC = (0.0D0,0.0D0)
DO I = TID, N, NTH
  FI = CONJG(F1(FBASE+I))
  GI = CONJG(G1(FBASE+I))
  WI = FI*CONJG(WORK(OFFR+I-1))
  TEMP1 = (0.0D0,0.0D0)
  TEMP2 = (0.0D0,0.0D0)
  DO K = 1, N
    AIJ = CONJG(WORK(OFFINV+I-1+(K-1)*N))
    BIJ = CONJG(WORK(OFFINV3+I-1+(K-1)*N))
    WK = CONJG(F1(FBASE+K)*WORK(OFFR+K-1))
    MPP_E = FI*AIJ*CONJG(F1(FBASE+K))-GI*BIJ*CONJG(G1(FBASE+K))
    IF (I == K) MPP_E = MPP_E-FI+GI
    MPP_E = 0.5D0*MPP_E+WI*WK
    TDIFF = -FI*AIJ+GI*BIJ
    TEMP1 = TEMP1+MPP_E*P1(FBASE+K)
    TEMP2 = TEMP2+TDIFF*P2(FBASE+K)
  END DO
  LOC = LOC+CONJG(VNA(I))*(-TEMP1+0.5D0*TEMP2)
END DO
CALL DEV_BLOCK_REDUCE_COMPLEX(LOC,SH,TID,NTH)
IF (TID == 1) GNEG(GIDX,13) = (LOC+0.5D0*SVR*SBR)*BASEG
END SUBROUTINE KERNEL_ISC_NEGATIVE_CROSS

SUBROUTINE CUDA_ISC_DUSCH_FULL_INTEGRAL(SUB, NVIB, STEPS_IN, A, B, BE, DE, ISC_SOC, EV_INI, EV_FINAL, &
  OMEGA1, OMEGA2, JMAT, DMAT, ZMAT, COUP_DER, F_HT_HT, F_NA_NA, F_HT_NA, NAC_SVC, USE_HT, USE_NASVC, &
  SIMPLIFIED_SVC, V_DSO_NA, M_HT_NA, S_DSO_NA, S_HT_NA, &
  USE_DAMP, DAMPING_WIDTH, INTEGRAL, IERR, GOUT, GDSO_OUT, GDHT_OUT, GHTHT_OUT, GNANA_OUT, GHTNA_OUT, &
  G11_OUT, G12_OUT, G13_OUT, G15_OUT, G16_OUT, G22_OUT, G23_OUT, G24_OUT, G25_OUT, G26_OUT, &
  WIN_OUT, GCOMP_OUT, GCOMP_NEG_OUT)
INTEGER, INTENT(IN) :: SUB, NVIB, STEPS_IN
REAL(DP), INTENT(IN) :: A, B, BE, DE, DAMPING_WIDTH
COMPLEX(DP), INTENT(IN) :: ISC_SOC
COMPLEX(DP), INTENT(IN) :: EV_INI(:), EV_FINAL(:), OMEGA1(:,:), OMEGA2(:,:), JMAT(:,:), DMAT(:,:), ZMAT(:,:)
COMPLEX(DP), INTENT(IN) :: COUP_DER(:,:), F_HT_HT(:,:), F_NA_NA(:,:), F_HT_NA(:,:), NAC_SVC(:)
COMPLEX(DP), INTENT(IN) :: V_DSO_NA(:), M_HT_NA(:,:), S_DSO_NA, S_HT_NA
LOGICAL, INTENT(IN) :: USE_HT, USE_NASVC, SIMPLIFIED_SVC, USE_DAMP
REAL(DP), INTENT(OUT) :: INTEGRAL
INTEGER, INTENT(OUT) :: IERR
REAL(DP), INTENT(OUT), OPTIONAL :: GOUT(:), GDSO_OUT(:), GDHT_OUT(:), GHTHT_OUT(:), GNANA_OUT(:), GHTNA_OUT(:)
REAL(DP), INTENT(OUT), OPTIONAL :: G11_OUT(:), G12_OUT(:), G13_OUT(:), G15_OUT(:), G16_OUT(:), G22_OUT(:)
REAL(DP), INTENT(OUT), OPTIONAL :: G23_OUT(:), G24_OUT(:), G25_OUT(:), G26_OUT(:), WIN_OUT(:)
COMPLEX(DP), INTENT(OUT), OPTIONAL :: GCOMP_OUT(:,:), GCOMP_NEG_OUT(:,:)
INTEGER :: STEPS, NPTS, N2, STRIDE, ISTAT, START, CHUNK, CHUNK_USE, I, IOSUM, ICB, NFAIL, FIRST_INFO, NEG_NPTS
INTEGER :: OFF_W2, OFF_W3, OFF_I2, OFF_I3, OFF_PM, OFF_MM, OFF_IP, OFF_IM, OFF_RAW1, OFF_RAW2
REAL(DP) :: H, SIGMA_DAMP, WIN, TRACE_O1_REAL, INTEG_H(1), SOC2
LOGICAL :: HAS_DHT, HAS_FHT, HAS_FNA, HAS_FHN, NEED_PM_INV
COMPLEX(DP), ALLOCATABLE :: O1(:), O2(:), JF(:), DV(:), ZV(:), BCOUP(:), &
  FHT(:), FNA(:), FHN(:), NACV(:), VNA(:), MNA(:), GDSO(:), GDHT(:), GHTHT(:), GNANA(:), GHTNA(:), &
  G11H(:), G12H(:), G13H(:), G15H(:), G16H(:), G22H(:), G23H(:), G24H(:), G25H(:), G26H(:), PHRATIO(:), GTMP(:)
REAL(DP), ALLOCATABLE :: GREAL(:)
INTEGER, ALLOCATABLE :: INFO_H(:)
COMPLEX(DP), DEVICE, ALLOCATABLE, TARGET :: D_WORK(:), D_J(:), D_MNA(:), D_MNAC(:)
COMPLEX(DP), DEVICE, ALLOCATABLE :: D_GNEG(:,:)
COMPLEX(DP), DEVICE, ALLOCATABLE :: D_EV1(:), D_EV2(:), D_O1(:), D_O2(:), D_D(:), D_Z(:), &
  D_B(:), D_FHT(:), D_FNA(:), D_FHN(:), D_NAC(:), D_VNA(:), &
  D_GDSO(:), D_GDHT(:), D_GHTHT(:), D_GNANA(:), D_GHTNA(:), D_PHASE_RATIO(:), &
  D_G11(:), D_G12(:), D_G13(:), D_G15(:), D_G16(:), D_G22(:), D_G23(:), D_G24(:), D_G25(:), D_G26(:), &
  D_DETW01(:), D_DET2(:), D_DET3(:), D_F1(:), D_G1(:), D_F2(:), D_G2(:), &
  D_P1(:), D_M1(:), D_P2(:), D_M2(:)
REAL(DP), DEVICE, ALLOCATABLE :: D_LDW01(:), D_LD2(:), D_LD3(:), D_GREAL(:), D_RDSO(:), D_RDHT(:), &
  D_RHTHT(:), D_RNANA(:), D_RHTNA(:), D_WIN(:), D_INTEG(:)
INTEGER, DEVICE, ALLOCATABLE :: D_INFO(:), D_PIV2(:), D_PIV3(:), D_PIVP(:), D_PIVM(:), &
  D_INFO2(:), D_INFO3(:), D_INFOI2(:), D_INFOI3(:), &
  D_INFOP(:), D_INFOM(:), D_INFOIP(:), D_INFOIM(:)
TYPE(c_devptr), DEVICE, ALLOCATABLE :: D_APTR(:), D_BPTR(:), D_CPTR(:)
TYPE(cublasHandle) :: HBLAS
TYPE(DIM3) :: GRID, GRIDF, GRIDW, GRIDT, BLOCK, BLOCK1

IERR = 0
INTEGRAL = 0.0D0
IF (.NOT. CUDA_FASTPATH_AVAILABLE()) THEN
  IERR = -7099
  RETURN
END IF
IF (NVIB <= 0 .OR. STEPS_IN <= 0) THEN
  IERR = -7002
  RETURN
END IF
STEPS = STEPS_IN
NPTS = STEPS + 1
NEG_NPTS = 1
IF (PRESENT(GCOMP_NEG_OUT)) NEG_NPTS = NPTS
H = (B - A) / DBLE(STEPS)
N2 = NVIB*NVIB

OFF_W2 = 1
OFF_W3 = N2 + 1
OFF_I2 = 2*N2 + 1
OFF_I3 = 3*N2 + 1
OFF_PM = 4*N2 + 1
OFF_MM = 5*N2 + 1
OFF_IP = 6*N2 + 1
OFF_IM = 7*N2 + 1
OFF_RAW1 = 8*N2 + 1
OFF_RAW2 = 9*N2 + 1
SIGMA_DAMP = 0.0D0
IF (USE_DAMP) THEN

  SIGMA_DAMP = 1.0D0 / DAMPING_WIDTH * 3.335653D-12 / AUT2S_CUDA
END IF

ALLOCATE(O1(NVIB), O2(NVIB), JF(N2), DV(NVIB), ZV(NVIB), BCOUP(NVIB), &
  FHT(N2), FNA(N2), FHN(N2), NACV(NVIB), VNA(NVIB), MNA(N2), STAT=ISTAT)
IF (ISTAT /= 0) THEN
  IERR = ISTAT
  RETURN
END IF
CALL CUDA_FILL_DIAG_AND_FLAT(NVIB, OMEGA1, OMEGA2, JMAT, DMAT, ZMAT, O1, O2, JF, DV, ZV)
TRACE_O1_REAL = SUM(REAL(O1))
BCOUP = (0.0D0, 0.0D0)
FHT = (0.0D0, 0.0D0)
FNA = (0.0D0, 0.0D0)
FHN = (0.0D0, 0.0D0)
NACV = (0.0D0, 0.0D0)
VNA = (0.0D0, 0.0D0)
MNA = (0.0D0, 0.0D0)
IF (USE_HT) THEN
  BCOUP = COUP_DER(1:NVIB,1)
  FHT = RESHAPE(F_HT_HT(1:NVIB,1:NVIB), [N2])
END IF
IF (USE_NASVC) THEN
  FNA = RESHAPE(F_NA_NA(1:NVIB,1:NVIB), [N2])
  NACV = NAC_SVC(1:NVIB)
END IF
IF (USE_HT .AND. USE_NASVC) THEN
  FHN = RESHAPE(F_HT_NA(1:NVIB,1:NVIB), [N2])
END IF
IF (USE_NASVC .AND. (.NOT. SIMPLIFIED_SVC)) THEN
  VNA = V_DSO_NA(1:NVIB)
  IF (USE_HT) MNA = RESHAPE(M_HT_NA(1:NVIB,1:NVIB), [N2])
END IF

HAS_DHT = USE_HT
HAS_FHT = USE_HT
HAS_FNA = USE_NASVC
HAS_FHN = USE_HT .AND. USE_NASVC
NEED_PM_INV = USE_NASVC

STRIDE = 10*N2
CHUNK_USE = CUDA_SAFE_CHUNK(NVIB, .TRUE.)
IF (NVIB <= 1200) CHUNK_USE = 2*CHUNK_USE
CHUNK_USE = MIN(CHUNK_USE, NPTS)
IF (CHUNK_USE <= 0) THEN
  IERR = -7004
  DEALLOCATE(O1, O2, JF, DV, ZV, BCOUP, FHT, FNA, FHN, NACV, VNA, MNA)
  RETURN
END IF

ALLOCATE(GDSO(NPTS), GDHT(NPTS), GHTHT(NPTS), GNANA(NPTS), GHTNA(NPTS), &
  G11H(NPTS), G12H(NPTS), G13H(NPTS), G15H(NPTS), G16H(NPTS), G22H(NPTS), &
  G23H(NPTS), G24H(NPTS), G25H(NPTS), G26H(NPTS), &
  PHRATIO(NPTS), GTMP(NPTS), GREAL(NPTS), INFO_H(NPTS), STAT=ISTAT)
IF (ISTAT /= 0) THEN
  IERR = ISTAT
  DEALLOCATE(O1, O2, JF, DV, ZV, BCOUP, FHT, FNA, FHN, NACV, VNA, MNA)
  RETURN
END IF

ALLOCATE(D_EV1(NVIB), D_EV2(NVIB), D_O1(NVIB), D_O2(NVIB), D_J(N2), D_D(NVIB), D_Z(NVIB), &
  D_B(NVIB), D_FHT(N2), D_FNA(N2), D_FHN(N2), D_NAC(NVIB), D_VNA(NVIB), D_MNA(N2), D_MNAC(N2), &
  D_WORK(STRIDE*CHUNK_USE), &
  D_GDSO(NPTS), D_GDHT(NPTS), D_GHTHT(NPTS), D_GNANA(NPTS), &
  D_GHTNA(NPTS), D_PHASE_RATIO(NPTS), D_DETW01(CHUNK_USE), D_DET2(CHUNK_USE), D_DET3(CHUNK_USE), &
  D_GNEG(NEG_NPTS,15), D_G11(NPTS), D_G12(NPTS), D_G13(NPTS), D_G15(NPTS), D_G16(NPTS), D_G22(NPTS), &
  D_G23(NPTS), D_G24(NPTS), D_G25(NPTS), D_G26(NPTS), &
  D_F1(NVIB*CHUNK_USE), D_G1(NVIB*CHUNK_USE), D_F2(NVIB*CHUNK_USE), D_G2(NVIB*CHUNK_USE), &
  D_P1(NVIB*CHUNK_USE), D_M1(NVIB*CHUNK_USE), D_P2(NVIB*CHUNK_USE), D_M2(NVIB*CHUNK_USE), &
  D_LDW01(CHUNK_USE), D_LD2(CHUNK_USE), D_LD3(CHUNK_USE), D_GREAL(NPTS), &
  D_RDSO(NPTS), D_RDHT(NPTS), D_RHTHT(NPTS), D_RNANA(NPTS), D_RHTNA(NPTS), D_WIN(NPTS), D_INTEG(1), &
  D_INFO(NPTS), D_PIV2(NVIB*CHUNK_USE), D_PIV3(NVIB*CHUNK_USE), &
  D_PIVP(NVIB*CHUNK_USE), D_PIVM(NVIB*CHUNK_USE), D_INFO2(CHUNK_USE), &
  D_INFO3(CHUNK_USE), D_INFOI2(CHUNK_USE), D_INFOI3(CHUNK_USE), D_INFOP(CHUNK_USE), &
  D_INFOM(CHUNK_USE), D_INFOIP(CHUNK_USE), D_INFOIM(CHUNK_USE), D_APTR(CHUNK_USE), &
  D_BPTR(CHUNK_USE), D_CPTR(CHUNK_USE), STAT=ISTAT)
IF (ISTAT /= 0) THEN
  IERR = ISTAT
  DEALLOCATE(O1, O2, JF, DV, ZV, BCOUP, FHT, FNA, FHN, NACV, VNA, MNA, &
    GDSO, GDHT, GHTHT, GNANA, GHTNA, G11H, G12H, G13H, G15H, G16H, &
    G22H, G23H, G24H, G25H, G26H, PHRATIO, GTMP, GREAL, INFO_H)
  RETURN
END IF

ISTAT = cublasCreate(HBLAS)
IF (ISTAT /= 0) THEN
  IERR = 120000 + ISTAT
  DEALLOCATE(D_GNEG, D_EV1, D_EV2, D_O1, D_O2, D_J, D_D, D_Z, D_B, &
    D_FHT, D_FNA, D_FHN, D_NAC, D_VNA, D_MNA, D_MNAC, D_WORK, &
    D_GDSO, D_GDHT, D_GHTHT, D_GNANA, D_GHTNA, &
    D_G11, D_G12, D_G13, D_G15, D_G16, D_G22, D_G23, D_G24, D_G25, D_G26, &
    D_PHASE_RATIO, D_DETW01, D_DET2, D_DET3, D_F1, D_G1, D_F2, D_G2, &
    D_P1, D_M1, D_P2, D_M2, D_LDW01, D_LD2, D_LD3, D_GREAL, D_RDSO, D_RDHT, &
    D_RHTHT, D_RNANA, D_RHTNA, D_WIN, D_INTEG, D_INFO, &
    D_PIV2, D_PIV3, D_PIVP, D_PIVM, D_INFO2, D_INFO3, D_INFOI2, D_INFOI3, D_INFOP, &
    D_INFOM, D_INFOIP, D_INFOIM, D_APTR, D_BPTR, D_CPTR)
  DEALLOCATE(O1, O2, JF, DV, ZV, BCOUP, FHT, FNA, FHN, NACV, VNA, MNA, &
    GDSO, GDHT, GHTHT, GNANA, GHTNA, G11H, G12H, G13H, G15H, G16H, &
    G22H, G23H, G24H, G25H, G26H, PHRATIO, GTMP, GREAL, INFO_H)
  RETURN
END IF

D_EV1 = EV_INI(1:NVIB); D_EV2 = EV_FINAL(1:NVIB)
D_O1 = O1; D_O2 = O2; D_J = JF; D_D = DV; D_Z = ZV
D_B = BCOUP; D_FHT = FHT; D_FNA = FNA; D_FHN = FHN; D_NAC = NACV
D_VNA = VNA; D_MNA = MNA; D_MNAC = CONJG(MNA)
D_INFO = 0
D_G11 = (0.0D0,0.0D0); D_G12 = (0.0D0,0.0D0); D_G13 = (0.0D0,0.0D0)
D_G15 = (0.0D0,0.0D0); D_G16 = (0.0D0,0.0D0)
D_G22 = (0.0D0,0.0D0); D_G23 = (0.0D0,0.0D0)
D_G24 = (0.0D0,0.0D0); D_G25 = (0.0D0,0.0D0)
D_G26 = (0.0D0,0.0D0)
D_GNEG = (0.0D0,0.0D0)
BLOCK = DIM3(32,1,1)
BLOCK1 = DIM3(BLOCK_SIZE,1,1)

DO START = 1, NPTS, CHUNK_USE
  CHUNK = MIN(CHUNK_USE, NPTS-START+1)
  GRID = DIM3(CHUNK,1,1)
  GRIDF = DIM3((NVIB*CHUNK + BLOCK_SIZE - 1)/BLOCK_SIZE,1,1)
  GRIDW = DIM3((CHUNK*N2 + BLOCK_SIZE - 1)/BLOCK_SIZE,1,1)
  GRIDT = DIM3((CHUNK + BLOCK_SIZE - 1)/BLOCK_SIZE,1,1)
  CALL KERNEL_DUSCH_BUILD_FACTORS<<<GRIDF, BLOCK1>>>(NVIB, CHUNK, START, A, H, BE, &
    D_EV1, D_EV2, D_O1, D_O2, D_F1, D_G1, D_F2, D_G2)
  ISTAT = cudaGetLastError()
  IF (ISTAT /= 0) THEN
    IERR = 91800 + ISTAT
    EXIT
  END IF
  CALL KERNEL_DUSCH_BUILD_W01_LOGPHASE<<<GRIDT, BLOCK1>>>(SUB, NVIB, CHUNK, START, A, H, BE, &
    D_EV1, D_EV2, D_O1, D_O2, D_Z, D_LDW01, D_DETW01)
  ISTAT = cudaGetLastError()
  IF (ISTAT /= 0) THEN
    IERR = 91900 + ISTAT
    EXIT
  END IF
  CALL KERNEL_DUSCH_SCALE_J_TWO<<<GRIDW, BLOCK1>>>(NVIB, CHUNK, D_J, D_F2, D_G2, &
    D_WORK, STRIDE, OFF_W2, OFF_W3)
  ISTAT = cudaGetLastError()
  IF (ISTAT /= 0) THEN
    IERR = 92000 + ISTAT
    EXIT
  END IF
  CALL CUDA_ZBATCH_GEMM_CONST_LEFT(HBLAS, NVIB, CHUNK, STRIDE, D_J, D_WORK, &
    OFF_W2, OFF_I2, D_APTR, D_BPTR, D_CPTR, ICB)
  IF (ICB /= 0) THEN
    IERR = ICB
    EXIT
  END IF
  CALL CUDA_ZBATCH_GEMM_CONST_LEFT(HBLAS, NVIB, CHUNK, STRIDE, D_J, D_WORK, &
    OFF_W3, OFF_I3, D_APTR, D_BPTR, D_CPTR, ICB)
  IF (ICB /= 0) THEN
    IERR = ICB
    EXIT
  END IF
  CALL KERNEL_DUSCH_FINISH_W_GEMM<<<GRIDW, BLOCK1>>>(SUB, NVIB, CHUNK, &
    D_O1, D_F1, D_G1, D_WORK, STRIDE)
  ISTAT = cudaGetLastError()
  IF (ISTAT /= 0) THEN
    IERR = 92100 + ISTAT
    EXIT
  END IF

  CALL CUDA_ZBATCH_FACTOR_INVERT_DET(HBLAS, NVIB, CHUNK, STRIDE, D_WORK, OFF_W2, OFF_I2, &
    D_APTR, D_CPTR, D_PIV2, D_INFO2, D_INFOI2, D_LD2, D_DET2, ICB)
  IF (ICB /= 0) THEN
    IERR = ICB
    EXIT
  END IF
  CALL CUDA_ZBATCH_FACTOR_INVERT_DET(HBLAS, NVIB, CHUNK, STRIDE, D_WORK, OFF_W3, OFF_I3, &
    D_APTR, D_CPTR, D_PIV3, D_INFO3, D_INFOI3, D_LD3, D_DET3, ICB)
  IF (ICB /= 0) THEN
    IERR = ICB
    EXIT
  END IF

  IF (NEED_PM_INV) THEN
    CALL KERNEL_DUSCH_BUILD_PM_FACTORS<<<GRIDF, BLOCK1>>>(NVIB, CHUNK, D_O1, D_O2, D_F1, D_F2, &
      D_P1, D_M1, D_P2, D_M2)
    ISTAT = cudaGetLastError()
    IF (ISTAT /= 0) THEN
      IERR = 92900 + ISTAT
      EXIT
    END IF
    CALL KERNEL_DUSCH_SCALE_J_TWO<<<GRIDW, BLOCK1>>>(NVIB, CHUNK, D_J, D_P2, D_M2, &
      D_WORK, STRIDE, OFF_PM, OFF_MM)
    ISTAT = cudaGetLastError()
    IF (ISTAT /= 0) THEN
      IERR = 93000 + ISTAT
      EXIT
    END IF
    CALL CUDA_ZBATCH_GEMM_CONST_LEFT(HBLAS, NVIB, CHUNK, STRIDE, D_J, D_WORK, &
      OFF_PM, OFF_IP, D_APTR, D_BPTR, D_CPTR, ICB)
    IF (ICB /= 0) THEN
      IERR = ICB
      EXIT
    END IF
    CALL CUDA_ZBATCH_GEMM_CONST_LEFT(HBLAS, NVIB, CHUNK, STRIDE, D_J, D_WORK, &
      OFF_MM, OFF_IM, D_APTR, D_BPTR, D_CPTR, ICB)
    IF (ICB /= 0) THEN
      IERR = ICB
      EXIT
    END IF
    CALL KERNEL_DUSCH_FINISH_PM_GEMM<<<GRIDW, BLOCK1>>>(NVIB, CHUNK, D_P1, D_M1, &
      D_WORK, STRIDE)
    ISTAT = cudaGetLastError()
    IF (ISTAT /= 0) THEN
      IERR = 93100 + ISTAT
      EXIT
    END IF
    CALL CUDA_ZBATCH_FACTOR_INVERT(HBLAS, NVIB, CHUNK, STRIDE, D_WORK, OFF_PM, OFF_IP, &
      D_APTR, D_CPTR, D_PIVP, D_INFOP, D_INFOIP, ICB)
    IF (ICB /= 0) THEN
      IERR = ICB
      EXIT
    END IF
    CALL CUDA_ZBATCH_FACTOR_INVERT(HBLAS, NVIB, CHUNK, STRIDE, D_WORK, OFF_MM, OFF_IM, &
      D_APTR, D_CPTR, D_PIVM, D_INFOM, D_INFOIM, ICB)
    IF (ICB /= 0) THEN
      IERR = ICB
      EXIT
    END IF
  END IF

  CALL KERNEL_ISC_DUSCH_CUBLAS_FINAL_PAR<<<GRID, BLOCK1>>>(SUB, NVIB, CHUNK, START, A, H, BE, DE, &
    REAL(ISC_SOC), AIMAG(ISC_SOC), TRACE_O1_REAL, MERGE(1,0,.NOT. SIMPLIFIED_SVC), &
    MERGE(1,0,HAS_DHT), MERGE(1,0,HAS_FHT), MERGE(1,0,HAS_FNA), MERGE(1,0,HAS_FHN), &
    D_EV1, D_EV2, D_O1, D_O2, D_J, D_D, D_B, &
    D_FHT, D_FNA, D_FHN, D_NAC, D_F1, D_G1, D_F2, D_G2, D_WORK, STRIDE, D_LDW01, D_LD2, D_LD3, D_DETW01, D_DET2, D_DET3, &
    D_INFO2, D_INFO3, D_INFOI2, D_INFOI3, D_INFOP, D_INFOM, D_INFOIP, D_INFOIM, &
    D_VNA, D_MNA, S_DSO_NA, S_HT_NA, &
    D_GDSO, D_GDHT, D_GHTHT, D_GNANA, D_GHTNA, &
    D_G11, D_G12, D_G13, D_G15, D_G16, D_G22, D_G23, D_G24, D_G25, D_G26, &
    D_PHASE_RATIO, D_INFO)
  ISTAT = cudaGetLastError()
  IF (ISTAT /= 0) THEN
    IERR = 94000 + ISTAT
    EXIT
  END IF
  IF ((.NOT. SIMPLIFIED_SVC) .AND. HAS_FNA) THEN
    CALL CUDA_ZBATCH_GEMM_WORK(HBLAS, NVIB, CHUNK, STRIDE, D_WORK, &
      OFF_RAW1, OFF_I2, OFF_W2, CUBLAS_OP_N, CUBLAS_OP_N, &
      D_APTR, D_BPTR, D_CPTR, ICB)
    IF (ICB /= 0) THEN
      IERR = ICB
      EXIT
    END IF
    CALL CUDA_ZBATCH_GEMM_WORK(HBLAS, NVIB, CHUNK, STRIDE, D_WORK, &
      OFF_RAW2, OFF_I3, OFF_W3, CUBLAS_OP_N, CUBLAS_OP_N, &
      D_APTR, D_BPTR, D_CPTR, ICB)
    IF (ICB /= 0) THEN
      IERR = ICB
      EXIT
    END IF
    CALL CUDA_ZBATCH_GEMM_WORK(HBLAS, NVIB, CHUNK, STRIDE, D_WORK, &
      OFF_W2, OFF_RAW1, OFF_IP, CUBLAS_OP_N, CUBLAS_OP_T, &
      D_APTR, D_BPTR, D_CPTR, ICB)
    IF (ICB /= 0) THEN
      IERR = ICB
      EXIT
    END IF
    CALL CUDA_ZBATCH_GEMM_WORK(HBLAS, NVIB, CHUNK, STRIDE, D_WORK, &
      OFF_W3, OFF_RAW2, OFF_IM, CUBLAS_OP_N, CUBLAS_OP_T, &
      D_APTR, D_BPTR, D_CPTR, ICB)
    IF (ICB /= 0) THEN
      IERR = ICB
      EXIT
    END IF
    CALL KERNEL_ISC_DUSCH_FULL_SVC_PAR<<<GRID, BLOCK1>>>(NVIB, CHUNK, START, &
      REAL(ISC_SOC), AIMAG(ISC_SOC), MERGE(1,0,HAS_DHT), &
      D_F1, D_G1, D_F2, D_G2, D_B, D_VNA, D_MNA, S_DSO_NA, S_HT_NA, &
      D_WORK, STRIDE, D_GDSO, D_GNANA, D_G12, D_G13, D_G15, &
      D_G16, D_G22, D_G23, D_G24, D_G25, D_G26, D_INFO)
    ISTAT = cudaGetLastError()
    IF (ISTAT /= 0) THEN
      IERR = 94100 + ISTAT
      EXIT
    END IF
    IF (HAS_DHT) THEN
      CALL KERNEL_ISC_FULL_G15_G24_FAST<<<GRID, BLOCK1>>>(NVIB, CHUNK, START, &
        D_F1, D_G1, D_B, D_VNA, D_MNA, D_WORK, STRIDE, D_P1, D_M1, D_P2, D_M2, &
        D_GDSO, D_G15, D_G24, D_INFO)
      ISTAT = cudaGetLastError()
      IF (ISTAT /= 0) THEN
        IERR = 94200 + ISTAT
        EXIT
      END IF
      CALL KERNEL_ISC_FULL_G22_CORRECTED<<<GRID, BLOCK1>>>(NVIB, CHUNK, START, &
        D_F1, D_G1, D_MNA, D_WORK, STRIDE, D_P1, D_M1, D_P2, D_M2, &
        D_GDSO, D_G22, D_INFO)
      ISTAT = cudaGetLastError()
      IF (ISTAT /= 0) THEN
        IERR = 94300 + ISTAT
        EXIT
      END IF
    END IF
  END IF
  IF (PRESENT(GCOMP_NEG_OUT) .AND. (HAS_DHT .OR. HAS_FNA)) THEN

    CALL KERNEL_ISC_NEGATIVE_CROSS<<<GRID, BLOCK1>>>(NVIB, CHUNK, START, NPTS, &
      MERGE(1,0,HAS_DHT), MERGE(1,0,HAS_FNA), MERGE(1,0,.NOT. SIMPLIFIED_SVC), &
      ISC_SOC, S_HT_NA, D_F1, D_G1, D_B, D_NAC, D_VNA, D_MNA, D_WORK, STRIDE, &
      D_P1, D_P2, D_GDSO, D_GNEG, D_INFO)
    ISTAT = cudaGetLastError()
    IF (ISTAT /= 0) THEN
      IERR = 94400 + ISTAT
      EXIT
    END IF
  END IF
END DO

IF (IERR == 0) THEN
  ISTAT = cudaDeviceSynchronize()
  IF (ISTAT /= 0) IERR = ISTAT
END IF
ISTAT = cublasDestroy(HBLAS)
IF (IERR == 0 .AND. ISTAT /= 0) IERR = 130000 + ISTAT

IF (IERR == 0) THEN
  INFO_H(1:NPTS) = D_INFO(1:NPTS)
  NFAIL = 0
  FIRST_INFO = 0
  DO I = 1, NPTS
    IF (INFO_H(I) /= 0) THEN
      NFAIL = NFAIL + 1
      IF (FIRST_INFO == 0) FIRST_INFO = INFO_H(I)
    END IF
  END DO
  IF (NFAIL /= 0) IERR = FIRST_INFO
END IF

IF (IERR == 0) THEN

  GDSO(1:NPTS) = D_GDSO(1:NPTS)
  IF (HAS_DHT) THEN
    GDHT(1:NPTS) = D_GDHT(1:NPTS)
  ELSE
    GDHT = (0.0D0,0.0D0)
  END IF
  IF (HAS_FHT) THEN
    GHTHT(1:NPTS) = D_GHTHT(1:NPTS)
  ELSE
    GHTHT = (0.0D0,0.0D0)
  END IF
  IF (HAS_FNA) THEN
    GNANA(1:NPTS) = D_GNANA(1:NPTS)
    G11H(1:NPTS) = D_G11(1:NPTS)
  ELSE
    GNANA = (0.0D0,0.0D0)
    G11H = (0.0D0,0.0D0)
  END IF
  IF (HAS_FHN) THEN
    GHTNA(1:NPTS) = D_GHTNA(1:NPTS)
  ELSE
    GHTNA = (0.0D0,0.0D0)
  END IF
  IF ((.NOT. SIMPLIFIED_SVC) .AND. HAS_FNA) THEN
    G12H(1:NPTS) = D_G12(1:NPTS)
    G13H(1:NPTS) = D_G13(1:NPTS)
    G15H(1:NPTS) = D_G15(1:NPTS)
    G16H(1:NPTS) = D_G16(1:NPTS)
    G22H(1:NPTS) = D_G22(1:NPTS)
    G23H(1:NPTS) = D_G23(1:NPTS)
    G24H(1:NPTS) = D_G24(1:NPTS)
    G25H(1:NPTS) = D_G25(1:NPTS)
    G26H(1:NPTS) = D_G26(1:NPTS)
  ELSE
    G12H = (0.0D0,0.0D0); G13H = (0.0D0,0.0D0)
    G15H = (0.0D0,0.0D0); G16H = (0.0D0,0.0D0)
    G22H = (0.0D0,0.0D0); G23H = (0.0D0,0.0D0)
    G24H = (0.0D0,0.0D0); G25H = (0.0D0,0.0D0)
    G26H = (0.0D0,0.0D0)
  END IF

  PHRATIO(1:NPTS) = D_PHASE_RATIO(1:NPTS)
  CALL CUDA_APPLY_DET_PHASE_UNWRAP(GDSO, PHRATIO, GTMP, NPTS, ICB)
  IF (ICB == 0) GDSO(1:NPTS) = GTMP(1:NPTS)
  IF (ICB == 0 .AND. HAS_DHT) THEN
    CALL CUDA_APPLY_DET_PHASE_UNWRAP(GDHT, PHRATIO, GTMP, NPTS, ICB)
    IF (ICB == 0) GDHT(1:NPTS) = GTMP(1:NPTS)
  END IF
  IF (ICB == 0 .AND. HAS_FHT) THEN
    CALL CUDA_APPLY_DET_PHASE_UNWRAP(GHTHT, PHRATIO, GTMP, NPTS, ICB)
    IF (ICB == 0) GHTHT(1:NPTS) = GTMP(1:NPTS)
  END IF
  IF (ICB == 0 .AND. HAS_FNA) THEN
    CALL CUDA_APPLY_DET_PHASE_UNWRAP(GNANA, PHRATIO, GTMP, NPTS, ICB)
    IF (ICB == 0) GNANA(1:NPTS) = GTMP(1:NPTS)
  END IF
  IF (ICB == 0 .AND. HAS_FHN) THEN
    CALL CUDA_APPLY_DET_PHASE_UNWRAP(GHTNA, PHRATIO, GTMP, NPTS, ICB)
    IF (ICB == 0) GHTNA(1:NPTS) = GTMP(1:NPTS)
  END IF
  IF (ICB == 0 .AND. HAS_FNA) THEN
    CALL CUDA_APPLY_DET_PHASE_UNWRAP(G11H, PHRATIO, GTMP, NPTS, ICB)
    IF (ICB == 0) G11H(1:NPTS) = GTMP(1:NPTS)
  END IF
  IF (ICB == 0 .AND. (.NOT. SIMPLIFIED_SVC) .AND. HAS_FNA) THEN
    CALL CUDA_APPLY_DET_PHASE_UNWRAP(G12H, PHRATIO, GTMP, NPTS, ICB)
    IF (ICB == 0) G12H(1:NPTS) = GTMP(1:NPTS)
    CALL CUDA_APPLY_DET_PHASE_UNWRAP(G13H, PHRATIO, GTMP, NPTS, ICB)
    IF (ICB == 0) G13H(1:NPTS) = GTMP(1:NPTS)
    CALL CUDA_APPLY_DET_PHASE_UNWRAP(G15H, PHRATIO, GTMP, NPTS, ICB)
    IF (ICB == 0) G15H(1:NPTS) = GTMP(1:NPTS)
    CALL CUDA_APPLY_DET_PHASE_UNWRAP(G16H, PHRATIO, GTMP, NPTS, ICB)
    IF (ICB == 0) G16H(1:NPTS) = GTMP(1:NPTS)
    CALL CUDA_APPLY_DET_PHASE_UNWRAP(G22H, PHRATIO, GTMP, NPTS, ICB)
    IF (ICB == 0) G22H(1:NPTS) = GTMP(1:NPTS)
    CALL CUDA_APPLY_DET_PHASE_UNWRAP(G23H, PHRATIO, GTMP, NPTS, ICB)
    IF (ICB == 0) G23H(1:NPTS) = GTMP(1:NPTS)
    CALL CUDA_APPLY_DET_PHASE_UNWRAP(G24H, PHRATIO, GTMP, NPTS, ICB)
    IF (ICB == 0) G24H(1:NPTS) = GTMP(1:NPTS)
    CALL CUDA_APPLY_DET_PHASE_UNWRAP(G25H, PHRATIO, GTMP, NPTS, ICB)
    IF (ICB == 0) G25H(1:NPTS) = GTMP(1:NPTS)
    CALL CUDA_APPLY_DET_PHASE_UNWRAP(G26H, PHRATIO, GTMP, NPTS, ICB)
    IF (ICB == 0) G26H(1:NPTS) = GTMP(1:NPTS)
  END IF
  IF (ICB == 0 .AND. (.NOT. SIMPLIFIED_SVC) .AND. HAS_FNA .AND. NPTS >= 3) THEN
    G22H(1) = CMPLX((4.0D0*REAL(G22H(2))-REAL(G22H(3)))/3.0D0,0.0D0,KIND=DP)
  END IF
  IF (ICB /= 0) IERR = -9310

  IF (IERR == 0) THEN
    SOC2 = REAL(ISC_SOC*CONJG(ISC_SOC))
    DO I = 1, NPTS
      GREAL(I) = SOC2*REAL(GDSO(I))
      WIN = 1.0D0
      IF (SUB == 5) THEN
        IF (HAS_DHT) GREAL(I) = GREAL(I) + REAL(GDHT(I))
        IF (HAS_FHT) GREAL(I) = GREAL(I) + REAL(GHTHT(I))
        IF (HAS_FNA) GREAL(I) = GREAL(I) + REAL(GNANA(I))
        IF (HAS_FNA) GREAL(I) = GREAL(I) + 2.0D0*REAL(G11H(I))
        IF (SIMPLIFIED_SVC) THEN
          IF (HAS_FHN) GREAL(I) = GREAL(I) + REAL(GHTNA(I))
        ELSE
          IF (HAS_FHN) GREAL(I) = GREAL(I) &
            + 2.0D0*REAL(G12H(I)+G13H(I)+G15H(I)+G16H(I)) &
            + REAL(GHTNA(I)) + REAL(G22H(I)+G23H(I)) &
            + 2.0D0*REAL(G24H(I)+G25H(I)+G26H(I))
        END IF
      END IF
      IF (USE_DAMP) THEN
        WIN = EXP(-0.5D0*((A + DBLE(I-1)*H)**2)/(SIGMA_DAMP*SIGMA_DAMP))
        GREAL(I) = WIN * GREAL(I)
      END IF
      IF (PRESENT(WIN_OUT)) WIN_OUT(I) = WIN
    END DO
  END IF

  IF (IERR == 0 .AND. PRESENT(GCOMP_OUT)) THEN
    GCOMP_OUT(1:NPTS,1) = GDSO
    GCOMP_OUT(1:NPTS,2) = 0.5D0*GDHT
    GCOMP_OUT(1:NPTS,3) = GHTHT
    GCOMP_OUT(1:NPTS,4) = G11H
    GCOMP_OUT(1:NPTS,5) = G12H
    GCOMP_OUT(1:NPTS,6) = G13H
    GCOMP_OUT(1:NPTS,7) = 0.5D0*GHTNA
    GCOMP_OUT(1:NPTS,8) = G15H
    GCOMP_OUT(1:NPTS,9) = G16H
    GCOMP_OUT(1:NPTS,10) = GNANA
    GCOMP_OUT(1:NPTS,11) = G22H
    GCOMP_OUT(1:NPTS,12) = G23H
    GCOMP_OUT(1:NPTS,13) = G24H
    GCOMP_OUT(1:NPTS,14) = G25H
    GCOMP_OUT(1:NPTS,15) = G26H
  END IF
  IF (IERR == 0 .AND. PRESENT(GCOMP_NEG_OUT)) THEN

    GCOMP_NEG_OUT(1:NPTS,:) = D_GNEG(1:NPTS,:)
    PHRATIO = CONJG(PHRATIO)
    DO I = 1, 15
      IF (I == 1 .OR. I == 3 .OR. I == 10 .OR. I == 11 .OR. I == 12) CYCLE
      CALL CUDA_APPLY_DET_PHASE_UNWRAP(GCOMP_NEG_OUT(:,I), PHRATIO, GTMP, NPTS, ICB)
      IF (ICB /= 0) EXIT
      GCOMP_NEG_OUT(1:NPTS,I) = GTMP(1:NPTS)
    END DO
    IF (ICB /= 0) IERR = -9311

    GCOMP_NEG_OUT(1:NPTS,1) = CONJG(GDSO)
    GCOMP_NEG_OUT(1:NPTS,3) = CONJG(GHTHT)
    GCOMP_NEG_OUT(1:NPTS,10) = CONJG(GNANA)
    GCOMP_NEG_OUT(1:NPTS,11) = CONJG(G22H)
    GCOMP_NEG_OUT(1:NPTS,12) = CONJG(G23H)
  END IF
  IF (IERR == 0 .AND. PRESENT(GOUT)) GOUT(1:NPTS) = GREAL(1:NPTS)
  IF (IERR == 0 .AND. PRESENT(GDSO_OUT)) GDSO_OUT(1:NPTS) = REAL(GDSO(1:NPTS))
  IF (IERR == 0 .AND. PRESENT(GDHT_OUT)) GDHT_OUT(1:NPTS) = REAL(0.5D0*GDHT(1:NPTS))
  IF (IERR == 0 .AND. PRESENT(GHTHT_OUT)) GHTHT_OUT(1:NPTS) = REAL(GHTHT(1:NPTS))
  IF (IERR == 0 .AND. PRESENT(GNANA_OUT)) GNANA_OUT(1:NPTS) = REAL(GNANA(1:NPTS))
  IF (IERR == 0 .AND. PRESENT(GHTNA_OUT)) GHTNA_OUT(1:NPTS) = REAL(0.5D0*GHTNA(1:NPTS))
  IF (IERR == 0 .AND. PRESENT(G11_OUT)) G11_OUT(1:NPTS) = REAL(G11H(1:NPTS))
  IF (IERR == 0 .AND. PRESENT(G12_OUT)) G12_OUT(1:NPTS) = REAL(G12H(1:NPTS))
  IF (IERR == 0 .AND. PRESENT(G13_OUT)) G13_OUT(1:NPTS) = REAL(G13H(1:NPTS))
  IF (IERR == 0 .AND. PRESENT(G15_OUT)) G15_OUT(1:NPTS) = REAL(G15H(1:NPTS))
  IF (IERR == 0 .AND. PRESENT(G16_OUT)) G16_OUT(1:NPTS) = REAL(G16H(1:NPTS))
  IF (IERR == 0 .AND. PRESENT(G22_OUT)) G22_OUT(1:NPTS) = REAL(G22H(1:NPTS))
  IF (IERR == 0 .AND. PRESENT(G23_OUT)) G23_OUT(1:NPTS) = REAL(G23H(1:NPTS))
  IF (IERR == 0 .AND. PRESENT(G24_OUT)) G24_OUT(1:NPTS) = REAL(G24H(1:NPTS))
  IF (IERR == 0 .AND. PRESENT(G25_OUT)) G25_OUT(1:NPTS) = REAL(G25H(1:NPTS))
  IF (IERR == 0 .AND. PRESENT(G26_OUT)) G26_OUT(1:NPTS) = REAL(G26H(1:NPTS))
  IF (IERR == 0) CALL SIMPSON_FROM_VECTOR(GREAL, A, B, STEPS_IN, INTEGRAL)
END IF

DEALLOCATE(D_GNEG, D_EV1, D_EV2, D_O1, D_O2, D_J, D_D, D_Z, D_B, &
  D_FHT, D_FNA, D_FHN, D_NAC, D_VNA, D_MNA, D_MNAC, D_WORK, &
  D_GDSO, D_GDHT, D_GHTHT, D_GNANA, D_GHTNA, D_PHASE_RATIO, &
  D_G11, D_G12, D_G13, D_G15, D_G16, D_G22, D_G23, D_G24, D_G25, D_G26, &
  D_DETW01, D_DET2, D_DET3, D_F1, D_G1, D_F2, D_G2, &
  D_P1, D_M1, D_P2, D_M2, D_LDW01, D_LD2, D_LD3, D_GREAL, D_RDSO, D_RDHT, &
  D_RHTHT, D_RNANA, D_RHTNA, D_WIN, D_INTEG, D_INFO, &
  D_PIV2, D_PIV3, D_PIVP, D_PIVM, D_INFO2, D_INFO3, D_INFOI2, D_INFOI3, D_INFOP, &
  D_INFOM, D_INFOIP, D_INFOIM, D_APTR, D_BPTR, D_CPTR)
DEALLOCATE(O1, O2, JF, DV, ZV, BCOUP, FHT, FNA, FHN, NACV, VNA, MNA, &
  GDSO, GDHT, GHTHT, GNANA, GHTNA, G11H, G12H, G13H, G15H, G16H, &
  G22H, G23H, G24H, G25H, G26H, PHRATIO, GTMP, GREAL, INFO_H)
END SUBROUTINE CUDA_ISC_DUSCH_FULL_INTEGRAL

SUBROUTINE CUDA_IC13_INTEGRAL(NVIB, STEPS_IN, A, B, BE, DE, EV_INI, EV_FINAL, OMEGA1, OMEGA2, &
  JMAT, DMAT, ZMAT, FMAT, USE_DAMP, DAMPING_WIDTH, INTEGRAL, IERR, GOUT, WIN_OUT)
INTEGER, INTENT(IN) :: NVIB, STEPS_IN
REAL(DP), INTENT(IN) :: A, B, BE, DE, DAMPING_WIDTH
COMPLEX(DP), INTENT(IN) :: EV_INI(:), EV_FINAL(:), OMEGA1(:,:), OMEGA2(:,:), JMAT(:,:), DMAT(:,:), ZMAT(:,:), FMAT(:,:)
LOGICAL, INTENT(IN) :: USE_DAMP
REAL(DP), INTENT(OUT) :: INTEGRAL
INTEGER, INTENT(OUT) :: IERR
REAL(DP), INTENT(OUT), OPTIONAL :: GOUT(:), WIN_OUT(:)
INTEGER :: STEPS, NPTS, N2, STRIDE, START, CHUNK, CHUNK_USE, ISTAT, I, IOSUM, ICB, NFAIL, FIRST_INFO, CUDA_IERR
INTEGER :: OFF_W2, OFF_W3, OFF_I2, OFF_I3, OFF_PM, OFF_MM, OFF_IP, OFF_IM
REAL(DP) :: H, SIGMA_DAMP, WIN, INTEG_H(1)
COMPLEX(DP), ALLOCATABLE :: O1(:), O2(:), JF(:), DV(:), ZV(:), FF(:), GCOMPLEX(:), GBASE(:), PHRATIO(:)
REAL(DP), ALLOCATABLE :: GREAL(:)
INTEGER, ALLOCATABLE :: INFO_H(:)
COMPLEX(DP), DEVICE, ALLOCATABLE, TARGET :: D_WORK(:)
COMPLEX(DP), DEVICE, ALLOCATABLE :: D_EV1(:), D_EV2(:), D_O1(:), D_O2(:), D_J(:), D_D(:), D_Z(:), D_F(:), &
  D_G(:), D_DETW01(:), D_DET2(:), D_DET3(:), D_F1(:), D_G1(:), D_F2(:), D_G2(:), &
  D_P1(:), D_M1(:), D_P2(:), D_M2(:), D_PHASE_RATIO(:)
REAL(DP), DEVICE, ALLOCATABLE :: D_LDW01(:), D_LD2(:), D_LD3(:), D_GREAL(:), D_WIN(:), D_INTEG(:)
INTEGER, DEVICE, ALLOCATABLE :: D_INFO(:), D_PIV2(:), D_PIV3(:), D_PIVP(:), D_PIVM(:), &
  D_INFO2(:), D_INFO3(:), D_INFOI2(:), D_INFOI3(:), &
  D_INFOP(:), D_INFOM(:), D_INFOIP(:), D_INFOIM(:)
TYPE(c_devptr), DEVICE, ALLOCATABLE :: D_APTR(:), D_CPTR(:)
TYPE(cublasHandle) :: HBLAS
TYPE(DIM3) :: GRID, GRIDF, GRIDW, GRIDT, GRIDR, BLOCK, BLOCK1
IERR = 0
INTEGRAL = 0.0D0
IF (.NOT. CUDA_FASTPATH_AVAILABLE()) THEN
  IERR = -7099
  RETURN
END IF
IF (NVIB <= 0 .OR. STEPS_IN <= 0) THEN
  IERR = -7002
  RETURN
END IF
STEPS = STEPS_IN
NPTS = STEPS + 1
H = (B - A) / DBLE(STEPS)
N2 = NVIB*NVIB
STRIDE = 8*N2
CHUNK_USE = CUDA_SAFE_CHUNK(NVIB, .TRUE.)
IF (CHUNK_USE <= 0) THEN
  IERR = -7004
  RETURN
END IF
OFF_W2 = 1; OFF_W3 = N2 + 1; OFF_I2 = 2*N2 + 1; OFF_I3 = 3*N2 + 1
OFF_PM = 4*N2 + 1; OFF_MM = 5*N2 + 1; OFF_IP = 6*N2 + 1; OFF_IM = 7*N2 + 1
SIGMA_DAMP = 0.0D0
IF (USE_DAMP) THEN

  SIGMA_DAMP = 1.0D0 / DAMPING_WIDTH * 3.335653D-12 / AUT2S_CUDA
END IF
ALLOCATE(O1(NVIB), O2(NVIB), JF(N2), DV(NVIB), ZV(NVIB), FF(N2), GCOMPLEX(NPTS), GBASE(NPTS), PHRATIO(NPTS), GREAL(NPTS), INFO_H(NPTS), STAT=ISTAT)
IF (ISTAT /= 0) THEN
  IERR = ISTAT
  RETURN
END IF
CALL CUDA_FILL_DIAG_AND_FLAT(NVIB, OMEGA1, OMEGA2, JMAT, DMAT, ZMAT, O1, O2, JF, DV, ZV)
FF = RESHAPE(FMAT(1:NVIB,1:NVIB), [N2])
ALLOCATE(D_EV1(NVIB), D_EV2(NVIB), D_O1(NVIB), D_O2(NVIB), D_J(N2), D_D(NVIB), D_Z(NVIB), D_F(N2), &
  D_WORK(STRIDE*CHUNK_USE), D_G(NPTS), D_DETW01(CHUNK_USE), D_DET2(CHUNK_USE), D_DET3(CHUNK_USE), &
  D_F1(NVIB*CHUNK_USE), D_G1(NVIB*CHUNK_USE), D_F2(NVIB*CHUNK_USE), D_G2(NVIB*CHUNK_USE), &
  D_P1(NVIB*CHUNK_USE), D_M1(NVIB*CHUNK_USE), D_P2(NVIB*CHUNK_USE), D_M2(NVIB*CHUNK_USE), &
  D_PHASE_RATIO(NPTS), D_LDW01(CHUNK_USE), D_LD2(CHUNK_USE), D_LD3(CHUNK_USE), D_GREAL(NPTS), D_WIN(NPTS), D_INTEG(1), &
  D_INFO(NPTS), D_PIV2(NVIB*CHUNK_USE), D_PIV3(NVIB*CHUNK_USE), D_PIVP(NVIB*CHUNK_USE), &
  D_PIVM(NVIB*CHUNK_USE), D_INFO2(CHUNK_USE), D_INFO3(CHUNK_USE), D_INFOI2(CHUNK_USE), &
  D_INFOI3(CHUNK_USE), D_INFOP(CHUNK_USE), D_INFOM(CHUNK_USE), D_INFOIP(CHUNK_USE), &
  D_INFOIM(CHUNK_USE), D_APTR(CHUNK_USE), D_CPTR(CHUNK_USE), STAT=ISTAT)
IF (ISTAT /= 0) THEN
  IERR = ISTAT
  DEALLOCATE(O1, O2, JF, DV, ZV, FF, GCOMPLEX, GBASE, PHRATIO, GREAL, INFO_H)
  RETURN
END IF
ISTAT = cublasCreate(HBLAS)
IF (ISTAT /= 0) THEN
  IERR = 120000 + ISTAT
  DEALLOCATE(D_EV1, D_EV2, D_O1, D_O2, D_J, D_D, D_Z, D_F, D_WORK, D_G, D_DETW01, D_DET2, D_DET3, &
    D_F1, D_G1, D_F2, D_G2, D_P1, D_M1, D_P2, D_M2, D_PHASE_RATIO, D_LDW01, D_LD2, D_LD3, D_GREAL, D_WIN, D_INTEG, &
    D_INFO, D_PIV2, D_PIV3, D_PIVP, D_PIVM, D_INFO2, D_INFO3, D_INFOI2, D_INFOI3, &
    D_INFOP, D_INFOM, D_INFOIP, D_INFOIM, D_APTR, D_CPTR)
  DEALLOCATE(O1, O2, JF, DV, ZV, FF, GCOMPLEX, GBASE, PHRATIO, GREAL, INFO_H)
  RETURN
END IF
D_EV1 = EV_INI(1:NVIB); D_EV2 = EV_FINAL(1:NVIB)
D_O1 = O1; D_O2 = O2; D_J = JF; D_D = DV; D_Z = ZV; D_F = FF
D_INFO = 0
BLOCK = DIM3(32,1,1)
BLOCK1 = DIM3(BLOCK_SIZE,1,1)
DO START = 1, NPTS, CHUNK_USE
  CHUNK = MIN(CHUNK_USE, NPTS-START+1)
  GRID = DIM3(CHUNK,1,1)
  GRIDF = DIM3((NVIB*CHUNK + BLOCK_SIZE - 1)/BLOCK_SIZE,1,1)
  GRIDW = DIM3((CHUNK*N2 + BLOCK_SIZE - 1)/BLOCK_SIZE,1,1)
  GRIDT = DIM3((CHUNK + BLOCK_SIZE - 1)/BLOCK_SIZE,1,1)
  CALL KERNEL_DUSCH_BUILD_FACTORS<<<GRIDF, BLOCK1>>>(NVIB, CHUNK, START, A, H, BE, &
    D_EV1, D_EV2, D_O1, D_O2, D_F1, D_G1, D_F2, D_G2)
  ISTAT = cudaGetLastError()
  IF (ISTAT /= 0) THEN
    IERR = 91800 + ISTAT
    EXIT
  END IF
  CALL KERNEL_DUSCH_BUILD_W01_LOGPHASE<<<GRIDT, BLOCK1>>>(13, NVIB, CHUNK, START, A, H, BE, &
    D_EV1, D_EV2, D_O1, D_O2, D_Z, D_LDW01, D_DETW01)
  ISTAT = cudaGetLastError()
  IF (ISTAT /= 0) THEN
    IERR = 91900 + ISTAT
    EXIT
  END IF
  CALL KERNEL_DUSCH_BUILD_W_BATCH_FACTORS_ELEM<<<GRIDW, BLOCK1>>>(13, NVIB, CHUNK, START, A, H, BE, &
    D_EV1, D_EV2, D_O1, D_O2, D_J, D_Z, D_F1, D_G1, D_F2, D_G2, D_WORK, STRIDE, D_LDW01, D_DETW01)
  ISTAT = cudaGetLastError()
  IF (ISTAT /= 0) THEN
    IERR = 92000 + ISTAT
    EXIT
  END IF
  CALL CUDA_ZBATCH_FACTOR_INVERT_DET(HBLAS, NVIB, CHUNK, STRIDE, D_WORK, OFF_W2, OFF_I2, &
    D_APTR, D_CPTR, D_PIV2, D_INFO2, D_INFOI2, D_LD2, D_DET2, ICB)
  IF (ICB /= 0) THEN
    IERR = ICB
    EXIT
  END IF
  CALL CUDA_ZBATCH_FACTOR_DET_ONLY(HBLAS, NVIB, CHUNK, STRIDE, D_WORK, OFF_W3, OFF_I3, &
    D_APTR, D_CPTR, D_PIV3, D_INFO3, D_INFOI3, D_LD3, D_DET3, ICB)
  IF (ICB /= 0) THEN
    IERR = ICB
    EXIT
  END IF
  CALL KERNEL_DUSCH_BUILD_PM_FACTORS<<<GRIDF, BLOCK1>>>(NVIB, CHUNK, D_O1, D_O2, D_F1, D_F2, &
    D_P1, D_M1, D_P2, D_M2)
  ISTAT = cudaGetLastError()
  IF (ISTAT /= 0) THEN
    IERR = 92900 + ISTAT
    EXIT
  END IF
  CALL KERNEL_DUSCH_BUILD_PM_BATCH_FACTORS_ELEM<<<GRIDW, BLOCK1>>>(NVIB, CHUNK, &
    D_J, D_P1, D_M1, D_P2, D_M2, D_WORK, STRIDE)
  ISTAT = cudaGetLastError()
  IF (ISTAT /= 0) THEN
    IERR = 93000 + ISTAT
    EXIT
  END IF
  CALL CUDA_ZBATCH_FACTOR_INVERT(HBLAS, NVIB, CHUNK, STRIDE, D_WORK, OFF_PM, OFF_IP, &
    D_APTR, D_CPTR, D_PIVP, D_INFOP, D_INFOIP, ICB)
  IF (ICB /= 0) THEN
    IERR = ICB
    EXIT
  END IF
  CALL CUDA_ZBATCH_FACTOR_INVERT(HBLAS, NVIB, CHUNK, STRIDE, D_WORK, OFF_MM, OFF_IM, &
    D_APTR, D_CPTR, D_PIVM, D_INFOM, D_INFOIM, ICB)
  IF (ICB /= 0) THEN
    IERR = ICB
    EXIT
  END IF
  CALL KERNEL_IC13_CUBLAS_FINAL_PAR<<<GRID, BLOCK1>>>(NVIB, CHUNK, START, A, H, BE, DE, &
    D_EV1, D_EV2, D_O1, D_O2, D_J, D_D, D_F, D_F1, D_G1, D_F2, D_G2, D_WORK, &
    D_LDW01, D_LD2, D_LD3, D_DETW01, D_DET2, D_DET3, &
    D_INFO2, D_INFO3, D_INFOI2, D_INFOI3, D_INFOP, D_INFOM, D_INFOIP, D_INFOIM, D_G, D_PHASE_RATIO, D_INFO)
  ISTAT = cudaGetLastError()
  IF (ISTAT /= 0) THEN
    IERR = 94000 + ISTAT
    EXIT
  END IF
END DO
IF (IERR == 0) THEN
  ISTAT = cudaDeviceSynchronize()
  IF (ISTAT /= 0) IERR = ISTAT
END IF
ISTAT = cublasDestroy(HBLAS)
IF (IERR == 0 .AND. ISTAT /= 0) IERR = 130000 + ISTAT
IF (IERR == 0) THEN
  INFO_H(1:NPTS) = D_INFO(1:NPTS)
  NFAIL = 0
  FIRST_INFO = 0
  DO I = 1, NPTS
    IF (INFO_H(I) /= 0) THEN
      NFAIL = NFAIL + 1
      IF (FIRST_INFO == 0) FIRST_INFO = INFO_H(I)
    END IF
  END DO
  IF (NFAIL /= 0) IERR = FIRST_INFO
END IF
IF (IERR == 0) THEN

  GBASE(1:NPTS) = D_G(1:NPTS)
  PHRATIO(1:NPTS) = D_PHASE_RATIO(1:NPTS)
  CALL CUDA_APPLY_DET_PHASE_UNWRAP(GBASE, PHRATIO, GCOMPLEX, NPTS, CUDA_IERR)
  IF (CUDA_IERR /= 0) THEN
    IERR = CUDA_IERR
  END IF
END IF
IF (IERR == 0) THEN
  DO I = 1, NPTS
    GREAL(I) = REAL(GCOMPLEX(I))
    WIN = 1.0D0
    IF (USE_DAMP) THEN
      WIN = EXP(-0.5D0*((A + DBLE(I-1)*H)**2)/(SIGMA_DAMP*SIGMA_DAMP))
      GREAL(I) = WIN * GREAL(I)
    END IF
    IF (PRESENT(WIN_OUT)) WIN_OUT(I) = WIN
  END DO
  CALL SIMPSON_FROM_VECTOR(GREAL, A, B, STEPS_IN, INTEGRAL)
  IF (PRESENT(GOUT)) GOUT(1:NPTS) = GREAL(1:NPTS)
END IF
DEALLOCATE(D_EV1, D_EV2, D_O1, D_O2, D_J, D_D, D_Z, D_F, D_WORK, D_G, D_DETW01, D_DET2, D_DET3, &
  D_F1, D_G1, D_F2, D_G2, D_P1, D_M1, D_P2, D_M2, D_PHASE_RATIO, D_LDW01, D_LD2, D_LD3, D_GREAL, D_WIN, D_INTEG, &
  D_INFO, D_PIV2, D_PIV3, D_PIVP, D_PIVM, D_INFO2, D_INFO3, D_INFOI2, D_INFOI3, &
  D_INFOP, D_INFOM, D_INFOIP, D_INFOIM, D_APTR, D_CPTR)
DEALLOCATE(O1, O2, JF, DV, ZV, FF, GCOMPLEX, GBASE, PHRATIO, GREAL, INFO_H)
END SUBROUTINE CUDA_IC13_INTEGRAL

END MODULE CUDA_FASTPATH
